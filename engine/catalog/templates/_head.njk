{#- Head contents in the fixed order of R-HTML-02. Included by base.njk; expects page data (title, description, canonical, noindex, ogImage, ogType, feedUrl) and globals (site, themeColors, fontPreload). -#}
{%- set alternates = page.url | allAlternates -%}
{%- set xDefault = page.url | xDefaultUrl -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if pageType == "home" %}{{ site.name }} · {{ site.tagline }}{% else %}{{ title }} · {{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
{%- if alternates and alternates.length %}
{%- for alt in alternates %}
<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ site.url }}{{ alt.url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ xDefault }}">
{%- endif %}
{%- if feedUrl %}
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ feedUrl }}">
{%- endif %}
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<meta name="theme-color" content="{{ themeColors.light }}" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="{{ themeColors.dark }}" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{%- if fontPreload %}
<link rel="preload" href="{{ fontPreload }}" as="font" type="font/woff2" crossorigin>
{%- endif %}
<link rel="stylesheet" href="/assets/app.css">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ title if pageType != 'home' else site.name }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ locale | ogLocale }}">
{%- for alt in alternates %}
<meta property="og:locale:alternate" content="{{ alt.lang | ogLocale }}">
{%- endfor %}
<meta property="og:image" content="{{ site.url }}{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title if pageType != 'home' else site.tagline }} · {{ site.name }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title if pageType != 'home' else site.name }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">
<script type="application/ld+json">{{ schemaJson | safe }}</script>
