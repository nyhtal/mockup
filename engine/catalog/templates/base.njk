{% from "components/skip-link.njk" import skipLink with context %}
{% from "components/announcement-bar.njk" import announcementBar with context %}
{% from "components/header.njk" import header with context %}
{% from "components/mobile-drawer.njk" import mobileDrawer with context %}
{% from "components/footer.njk" import footer with context %}
{% from "components/sticky-cta.njk" import stickyCta with context %}
{% from "components/contact-launcher.njk" import contactLauncher with context %}
{%- set alternates = page.url | allAlternates -%}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}" data-motion="{{ flair.level }}" class="scheme-light-dark data-[theme=light]:scheme-light data-[theme=dark]:scheme-dark scroll-pt-20 motion-safe:scroll-smooth [interpolate-size:allow-keywords]">
<head>
{% include "templates/_head.njk" %}
</head>
{#- Locale typography (R-TYPO-05, R-LAY-05): German hyphenates (long compounds in headings), everything wraps long words; Arabic gets snug headings and no letter-spacing.
    Japanese (R-TYPO-13): the same, plus strict kinsoku line breaking, headings broken between phrases rather than inside a word, spacing between Japanese and Latin text, and no faux italics (the system faces have none; emphasis is bold). -#}
<body id="top" class="bg-surface font-sans text-ink antialiased{% if locale == 'de' %} hyphens-auto{% endif %} wrap-anywhere{% if locale in ['ar', 'ja'] %} [&_h1]:leading-snug [&_h2]:leading-snug [&_h3]:leading-snug [&_*]:tracking-normal{% endif %}{% if locale == 'ja' %} [line-break:strict] [text-autospace:normal] [font-synthesis-style:none] [&_:is(h1,h2,h3)]:[word-break:auto-phrase] [&_em]:font-semibold{% endif %}" data-page="{{ pageType or 'generic' }}">
{{ skipLink() }}
{%- if site.announcement and (pageType == "home" or not site.announcement.homeOnly) %}{{ announcementBar(site.announcement, locale) }}{% endif %}
{{ header(site, locale, page.url, alternates, { variant: headerVariant }) }}
{{ mobileDrawer(site.nav, locale, page.url, site.cta, alternates, { search: site.hasSearch }) }}
<main id="main">
{{ content | safe }}
{%- if pageType == "home" and site.cta %}{{ stickyCta(site.cta, locale) }}{% endif %}
</main>
{%- if pageType in ["pricing", "service", "industry"] and site.contact %}{{ contactLauncher(site.contact, locale) }}{% endif %}
{{ footer(site, locale, alternates) }}
<!--sprite--><script type="module" src="/assets/enhance.js"></script>
</body>
</html>
