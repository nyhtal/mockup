{#
  name: logo
  purpose: The site's identity lockup: the generated mark beside the wordmark (DESIGN §4, R-ASSET-09).
  anatomy: span[data-component=logo] > svg(mark: rounded tile in brand-600, bottom-end corner cut, the site's initial in inverse ink) + wordmark(ink)
  variants: none; opts.size sets the mark's height (default size-7 xl:size-8) and the wordmark follows
  states: none
  spacing: gap-2.5 between mark and wordmark
  motion: none
  keyboard: not focusable (the header and footer wrap it in the home link)
  a11y: the mark is decorative (aria-hidden); the wordmark carries the name as its title
  i18n: the mark is not mirrored in RTL; the initial is the site's name's first character
  content limits: name ≤ 24 characters
#}
{% from "primitives/wordmark.njk" import wordmark with context %}
{% macro logo(name, opts={}) %}
<span class="inline-flex items-center gap-2.5" data-component="logo">
<svg aria-hidden="true" class="{{ opts.size or 'size-7 xl:size-8' }} shrink-0" viewBox="0 0 64 64"><path class="fill-brand-600" d="M14 0H50a14 14 0 0 1 14 14V42L42 64H14a14 14 0 0 1 -14 -14V14a14 14 0 0 1 14 -14z"/><text class="fill-ink-inverse" x="30" y="33" text-anchor="middle" dominant-baseline="central" font-family="Arial, Helvetica, sans-serif" font-size="38" font-weight="700">{{ name | trim | first }}</text></svg>
{{ wordmark(name, { size: opts.wordmark or "h-6 xl:h-7", variant: "ink" }) }}
</span>
{% endmacro %}
