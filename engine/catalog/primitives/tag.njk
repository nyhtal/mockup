{#
  name: tag
  purpose: Topic or filter token, optionally linking to an archive (R-PAGE-11).
  anatomy: a[href] | span, [data-component=tag]
  variants: link | static
  states: hover (link only), focus-visible
  spacing: px-2 py-1; parents use flex flex-wrap gap-2
  motion: motion-safe:transition-colors
  keyboard: native when a link
  a11y: text only
  i18n: none
  content limits: label ≤ 20 chars
#}
{#- rel: "tag" when the link goes to the index of a tag the current article carries (to-do 5). -#}
{% macro tag(label, href, rel) %}
{%- if href -%}
<a href="{{ href }}"{% if rel %} rel="{{ rel }}"{% endif %} class="inline-flex items-center rounded-md bg-surface-alt px-2 py-1 text-sm text-ink hover:bg-brand-100 hover:text-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150" data-component="tag" data-variant="link">{{ label }}</a>
{%- else -%}
<span class="inline-flex items-center rounded-md bg-surface-alt px-2 py-1 text-sm text-ink" data-component="tag" data-variant="static">{{ label }}</span>
{%- endif -%}
{% endmacro %}
