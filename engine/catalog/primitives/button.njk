{#
  name: button
  purpose: Every action and call-to-action control (R-COMP-05, R-HTML-09).
  anatomy: a[href] | button[type] > (icon) + label + (iconEnd) + (sr-only new-tab hint)
  variants: primary (one per view) | secondary | ghost | link | inverse and inverse-outline (on brand or gradient backgrounds only); sizes sm | md | lg
  states: default, hover, focus-visible (ring), active, disabled (opacity-60, cursor-not-allowed), pending (opts.pending: spinner + "Sending…", disabled)
  spacing: min-h-11 px-5 (md); gap-2 between icon and label
  motion: motion-safe:transition-colors duration-150
  keyboard: native; a for navigation, button for actions, never href="#"
  a11y: label is visible text; external links add an sr-only "opens in a new tab" and rel="noopener"
  i18n: label ≤ 25 chars in every locale (R-TYPO-07); icons that point along the reading direction pass rtl:-scale-x-100
  content limits: verb-first label, 1–4 words (R-CONT-05); opts = { href, variant, size, icon, iconEnd, type, external, disabled, pending, attrs, gesture }
#}
{% from "primitives/icon.njk" import icon with context %}
{% macro button(label, opts={}) %}
{%- set variant = opts.variant or "primary" -%}
{%- set size = opts.size or "md" -%}
{#- The hover vocabulary of R-MOT-07: lift one pixel with a deeper shadow, settle and press on active, nudge the trailing arrow; link buttons grow an underline from the start edge instead. -#}
{%- set base = "group inline-flex items-center justify-center gap-2 rounded-md font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-[color,background-color,border-color,translate,scale] motion-safe:duration-150 motion-safe:ease-out" -%}
{%- set lift = " motion-safe:hover:-translate-y-px hover:shadow-md active:translate-y-0 motion-safe:active:scale-[0.98]" -%}
{%- set sizes = { sm: "min-h-9 px-4 text-sm", md: "min-h-11 px-5", lg: "min-h-12 px-6 text-lg" } -%}
{%- set variants = {
  primary: "bg-brand-600 text-ink-inverse shadow-sm shadow-brand-900/10 hover:bg-brand-700 active:bg-brand-800" + lift,
  secondary: "border border-line-strong bg-surface-raised text-ink hover:border-brand-300 hover:bg-surface-alt active:bg-surface-alt" + lift,
  ghost: "text-ink hover:bg-surface-alt active:bg-surface-alt" + lift,
  link: "relative min-h-0 rounded-none px-0 text-ink-brand after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-current after:scale-x-0 after:origin-left rtl:after:origin-right motion-safe:after:transition-transform motion-safe:after:duration-150 hover:after:scale-x-100",
  inverse: "bg-brand-50 text-brand-800 shadow-sm shadow-ink/10 hover:bg-brand-100 active:bg-brand-100" + lift,
  "inverse-outline": "border border-ink-inverse/70 text-ink-inverse hover:bg-ink-inverse/10 active:bg-ink-inverse/15" + lift
} -%}
{%- set iconEnd = opts.iconEnd or ("arrow-right" if (variant == "primary" or variant == "inverse") and not opts.noArrow) -%}
{%- set nudge = "motion-safe:transition-transform motion-safe:duration-150 group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5" -%}
{#- opts.gesture: the trailing arrow also nudges once after its section arrives (D66); only the CTA band passes it. -#}
{%- if opts.gesture %}{% set nudge = nudge + " gesture-nudge" %}{% endif -%}
{%- set classes = base + " " + (sizes[size] if variant != "link" else "") + " " + variants[variant] + (" " + opts.class if opts.class else "") -%}
{%- set iconClass = "size-5" if size != "sm" else "size-4" -%}
{%- if opts.href -%}
<a href="{{ opts.href }}" class="{{ classes }}" data-component="button" data-variant="{{ variant }}"{% if opts.external %} rel="noopener" target="_blank"{% endif %}{% for k, v in opts.attrs %} {{ k }}="{{ v }}"{% endfor %}>
{%- if opts.icon %}{{ icon(opts.icon, { size: iconClass }) }}{% endif %}{{ label }}{% if iconEnd %}{{ icon(iconEnd, { size: iconClass, class: nudge }) }}{% endif %}
{%- if opts.external %}{{ icon("external-link", { size: "size-4" }) }}<span class="sr-only">{{ "ui.opensNewTab" | t }}</span>{% endif -%}
</a>
{%- else -%}
<button type="{{ opts.type or 'button' }}" class="{{ classes }} disabled:cursor-not-allowed disabled:opacity-60" data-component="button" data-variant="{{ variant }}"{% if opts.disabled or opts.pending %} disabled{% endif %}{% for k, v in opts.attrs %} {{ k }}="{{ v }}"{% endfor %}>
{%- if opts.pending %}{{ icon("loader-circle", { size: iconClass, class: "motion-safe:animate-spin" }) }}{{ "ui.sending" | t }}
{%- else %}{% if opts.icon %}{{ icon(opts.icon, { size: iconClass }) }}{% endif %}{{ label }}{% if iconEnd %}{{ icon(iconEnd, { size: iconClass, class: nudge }) }}{% endif %}{% endif -%}
</button>
{%- endif %}
{% endmacro %}
