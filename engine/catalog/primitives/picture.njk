{#
  name: picture
  purpose: Responsive placeholder image in AVIF with reserved space (R-HTML-12, R-PERF-05, R-ASSET-06).
  anatomy: img[srcset(avif per width) sizes src(480 avif) width height alt loading|fetchpriority decoding]; one format, so no picture element
  variants: priority (the page's LCP image: fetchpriority=high, eager) | default (lazy)
  states: none
  spacing: none; the caller wraps it in an aspect box (R-LAY-10) via opts.class e.g. "aspect-video w-full object-cover rounded-xl"
  motion: none
  keyboard: not focusable
  a11y: img.alt is required: a sentence for informative images, "" for decorative (R-CONT-16)
  i18n: alt comes from the page's locale content
  content limits: img = { slug, ratio: "16:9"|"4:3"|"3:2"|"1:1"|"21:9"|"3:4", alt, max: 480|768|1200|1600, art: a piece id from engine/art/manifest.json, tone: "dark"|"light" }; opts = { priority, sizes, class }; art and tone are optional (absent: seeded by the slug from brand.art) and travel to the build as data-art / data-tone (R-ASSET-05, R-ASSET-06)
#}
{% macro picture(img, opts={}) %}
{%- set ratio = (img.ratio or "16:9") | replace(":", "x") -%}
{%- set parts = (img.ratio or "16:9").split(":") -%}
{%- set max = img.max or 1600 -%}
{%- set widths = [480, 768, 1200, 1600] -%}
{%- set sizes = opts.sizes or "100vw" -%}
{%- set h = ((max * parts[1]) / parts[0]) | round -%}
<img src="/assets/images/{{ img.slug }}-{{ ratio }}-480.avif" srcset="{% for w in widths %}{% if w <= max %}{% if not loop.first %}, {% endif %}/assets/images/{{ img.slug }}-{{ ratio }}-{{ w }}.avif {{ w }}w{% endif %}{% endfor %}" sizes="{{ sizes }}" width="{{ max }}" height="{{ h }}" alt="{{ img.alt }}"{% if opts.priority %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async"{% if img.art %} data-art="{{ img.art }}"{% endif %}{% if img.tone %} data-tone="{{ img.tone }}"{% endif %}{% if opts.class %} class="{{ opts.class }}"{% endif %}>
{% endmacro %}
