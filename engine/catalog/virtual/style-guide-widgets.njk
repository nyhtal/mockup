---
layout: base.njk
pageType: style-guide
noindex: true
---
{#- Every interactive widget on one page, working, each with where the site uses it (owner's request, 2026-10-19: "add test page with all widgets on it"). -#}
{% from "sections/_render.njk" import section with context %}
{% from "components/theme-toggle.njk" import themeToggle with context %}
{% from "components/sound-toggle.njk" import soundToggle with context %}
{% from "components/announcement-bar.njk" import announcementBar with context %}
{% from "components/share-links.njk" import shareLinks with context %}
{% from "components/toast.njk" import toast with context %}
{% from "components/tooltip.njk" import tooltip with context %}
{% from "components/dialog.njk" import dialog, dialogTrigger with context %}
{% from "components/drawer.njk" import drawer, drawerTrigger with context %}
{% from "components/image-gallery.njk" import gallery with context %}
{% from "components/accordion.njk" import accordion with context %}
{% from "components/tabs.njk" import tabs with context %}
{% from "components/progress.njk" import progress with context %}
{% from "components/skeleton.njk" import skeleton with context %}
{% from "components/search-box.njk" import searchBox with context %}
{% from "components/stat.njk" import stat with context %}
{% from "components/video-facade.njk" import videoFacade with context %}
{% from "components/map-facade.njk" import mapFacade with context %}
{% from "components/contact-launcher.njk" import contactLauncher with context %}
{% from "components/sticky-cta.njk" import stickyCta with context %}
{% from "primitives/field.njk" import field with context %}
{%- set sg = "/" + locale + "/style-guide/" -%}
{%- set L = "/" + locale + "/" -%}
{%- set link = "underline underline-offset-4 hover:text-ink-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" -%}
{%- set ctx = { locale: locale, pageUrl: page.url, density: "comfortable", surface: "bg-surface", reveal: false, demote: false } -%}
{%- set widgets = [
  ["toggles", "Theme and sound toggles"], ["notice", "Announcement bar"], ["copy", "Copy, share and toast"], ["tooltip", "Tooltip"],
  ["dialog", "Dialog and drawer"], ["lightbox", "Lightbox gallery"], ["accordion", "Accordion and tabs"], ["forms", "Date, time and range inputs"],
  ["search", "Search with suggestions"], ["progress", "Progress and skeleton"], ["countup", "Count-up figures"], ["facades", "Video and map facades"],
  ["pricing", "Billing toggle and estimate"], ["carousel", "Carousel and star ratings"], ["avatars", "Avatar stack"], ["compare", "Before and after slider"],
  ["map", "Office map"], ["frame", "Framed newsletter issue"], ["launcher", "Contact launcher"], ["sticky", "Sticky call to action"]
] -%}
{% macro block(id, title, used) %}
<section id="w-{{ id }}" class="scroll-mt-24 border-t border-line py-12" aria-labelledby="w-{{ id }}-h">
<h2 id="w-{{ id }}-h" class="text-2xl font-semibold tracking-tight">{{ title }}</h2>
<p class="mt-2 max-w-prose text-sm text-ink-muted">{{ used | safe }}</p>
<div class="mt-8">{{ caller() }}</div>
</section>
{% endmacro %}
{% macro note(id, used) %}<div id="w-{{ id }}" class="scroll-mt-24 border-t border-line pt-12"><p class="mx-auto w-full max-w-7xl px-4 text-sm text-ink-muted sm:px-6 lg:px-8">{{ used | safe }}</p></div>{% endmacro %}

<div class="mx-auto w-full max-w-7xl px-4 pt-16 sm:px-6 md:pt-24 lg:px-8">
<p class="text-sm font-medium uppercase tracking-wide text-ink-brand">Style guide</p>
<h1 class="mt-2 text-4xl md:text-5xl font-bold tracking-tight text-balance">Widgets</h1>
<p class="mt-4 max-w-2xl text-lg md:text-xl text-ink-muted">Every interactive widget of the site on one page, working as it does on the page that uses it. Each one says where that is. Widgets that need script say so; everything else works without it.</p>
<nav aria-label="Widgets on this page" class="mt-8"><ul class="flex flex-wrap gap-2">{% for w in widgets %}<li><a href="#w-{{ w[0] }}" class="inline-flex min-h-9 items-center rounded-full border border-line-strong px-3 text-sm text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ w[1] }}</a></li>{% endfor %}</ul></nav>

{% call block("toggles", "Theme and sound toggles", 'In the header from 1280 px, the mobile drawer and the footer of every page. The theme choice is remembered (<code>localStorage</code>); sound lasts for the tab. Script only.') %}
<div class="flex flex-wrap items-center gap-4">{{ themeToggle({ show: "inline-flex" }) }}{{ soundToggle() }}</div>
{% endcall %}

{% call block("notice", "Announcement bar", 'On the <a class="' + link + '" href="' + L + '">home page</a>, above the header. Dismissing it hides it for the rest of the session, from the first paint (script for the button only).') %}
{{ announcementBar({ key: "site.notice", linkKey: "site.noticeLink", href: "/events/safety-plcs-webinar/", dismissible: true }, locale) }}
{% endcall %}

{% call block("copy", "Copy, share and toast", 'On every <a class="' + link + '" href="' + L + 'blog/reading-generated-code/">post</a> (copy the link, or the device\'s share sheet) and every <a class="' + link + '" href="' + L + 'about/locations/hamburg/">office page</a> (copy the address). The message appears in a live region at the bottom of the window. Script only; the static toasts below are the catalog\'s other tones.') %}
{{ shareLinks({ url: "https://example.com" + page.url, title: "Widgets" }) }}
<div class="mt-6 grid gap-4 sm:grid-cols-2">{{ toast({ tone: "success", text: "Preferences saved." }, { inline: true }) }}{{ toast({ tone: "warning", text: "Your session ends in five minutes." }, { inline: true }) }}</div>
{% endcall %}

{% call block("tooltip", "Tooltip", 'On <a class="' + link + '" href="' + L + 'pricing/">pricing</a>, explaining what counts as a line. A hint popover: opens on click or Enter, closes with Escape. No script.') %}
<p class="text-sm">{{ tooltip("w-tip", "What counts as a line?", "One production line under one controller, from infeed to palletiser.") }}</p>
{% endcall %}

{% call block("dialog", "Dialog and drawer", 'Dialogs open the gallery pictures and the consent preferences; the drawer is the mobile navigation. Invoker commands, with a script fallback for older browsers.') %}
<div class="flex flex-wrap gap-4">{{ dialogTrigger("w-demo-dialog", "Open a dialog") }}{{ drawerTrigger("w-demo-drawer", "Open a drawer") }}</div>
{{ dialog("w-demo-dialog", "A dialog", "<p>Escape, the close button or a click outside closes it, and focus returns to the button.</p>", { size: "sm" }) }}
{{ drawer("w-demo-drawer", "A drawer", "<p>It slides in from the start edge and mirrors in Arabic.</p>") }}
{% endcall %}

{% call block("lightbox", "Lightbox gallery", 'On the <a class="' + link + '" href="' + L + 'careers/culture/">culture page</a> and every office page. Previous and next, the arrow keys (script), Escape and a click outside.') %}
{{ gallery([{ slug: "culture-floor", ratio: "4:3", alt: "", caption: "The floor in Manchester", max: 768 }, { slug: "culture-lab", ratio: "4:3", alt: "", caption: "Test lab", max: 768 }, { slug: "culture-team", ratio: "4:3", alt: "", caption: "Hamburg team day", max: 768 }], { id: "w-gallery" }) }}
{% endcall %}

{% call block("accordion", "Accordion and tabs", 'The <a class="' + link + '" href="' + L + 'faq/">FAQ</a>, help and pricing questions use the accordion; resources use the tabs. Both are <code>&lt;details&gt;</code> that open and close smoothly. No script.') %}
{{ accordion([{ title: "Does Northwind replace our PLCs?", body: "<p>No. It generates the logic they run.</p>", open: true }, { title: "How long does commissioning take?", body: "<p>Most single lines are live within two weeks.</p>" }], { variant: "exclusive", group: "w-acc" }) }}
<div class="mt-8">{{ tabs([{ label: "Guides", body: "<p>Step-by-step guides.</p>" }, { label: "Recordings", body: "<p>Webinar recordings.</p>" }], { group: "w-tabs" }) }}</div>
{% endcall %}

{% call block("forms", "Date, time and range inputs", 'On the <a class="' + link + '" href="' + L + 'demo/">demo form</a> and the landing pages. The range input\'s output follows it with script; the native pickers need none.') %}
<div class="grid max-w-xl gap-6 sm:grid-cols-2">
{{ field({ type: "date", name: "w-day", id: "w-day", label: "Preferred day", attrs: { min: "2026-10-20" } }) }}
{{ field({ type: "time", name: "w-time", id: "w-time", label: "Preferred time", attrs: { min: "08:00", max: "17:00", step: "1800" } }) }}
<div class="sm:col-span-2">{{ field({ type: "range", name: "w-lines", id: "w-lines", label: "Lines on the site", value: "4", attrs: { min: "1", max: "40" } }) }}</div>
</div>
{% endcall %}

{% call block("search", "Search with suggestions", 'The <a class="' + link + '" href="' + L + 'search/">search page</a> suggests queries from a <code>&lt;datalist&gt;</code>; its results filter by type without script and page in threes.') %}
{{ searchBox(locale, { id: "q-w", suggestions: ["PLC", "commissioning", "recipe", "audit trail"] }) }}
{% endcall %}

{% call block("progress", "Progress and skeleton", 'Job applications show their step in a <a class="' + link + '" href="' + L + 'careers/technical-writer/">&lt;progress&gt;</a>; the <a class="' + link + '" href="' + L + 'newsletter/">newsletter</a> issue loads over a skeleton.') %}
<div class="grid gap-8 md:grid-cols-2"><div>{{ progress(1, 3, "Your details") }}</div><div class="grid gap-4">{{ skeleton("text") }}</div></div>
{% endcall %}

{% call block("countup", "Count-up figures", 'Stats bands below the fold on the <a class="' + link + '" href="' + L + '">home page</a> and service pages count up once as they arrive, never with reduced motion. Script only; the figure is always in the text.') %}
<div class="grid grid-cols-2 gap-8 md:grid-cols-3">{{ stat({ value: "1,284", label: "Lines automated" }, { count: true }) }}{{ stat({ value: "38%", label: "Less downtime" }, { count: true }) }}{{ stat({ value: "99.98%", label: "Uptime last year" }, { count: true }) }}</div>
{% endcall %}

{% call block("facades", "Video and map facades", 'A poster and a link stand in for the video on the <a class="' + link + '" href="' + L + '">home page</a> and for the map on office pages, so no third party loads.') %}
<div class="grid gap-8 md:grid-cols-2">{{ videoFacade({ id: "w-video", title: "Northwind in four minutes", duration: "4:12", poster: { slug: "video-poster", ratio: "16:9", alt: "", max: 768 }, provider: "YouTube" }) }}{{ mapFacade({ slug: "map-manchester", address: "4 Canal Street, Manchester M1 3HE, United Kingdom" }) }}</div>
{% endcall %}
</div>

{{ note("pricing", 'On <a class="' + link + '" href="' + L + 'pricing/">pricing</a>: the billing radios swap every tier\'s price through <code>:has()</code> without script; the estimate\'s output follows its range input with script.') }}
{{ section({ type: "pricing", title: "Billing toggle and estimate", tiers: [
  { name: "Starter", price: "€490", amount: 490, annual: "€408", annualAmount: 408, period: "per line per month", features: ["Up to 50 tags"], cta: { label: "Start a trial", href: L + "demo/" } },
  { name: "Plant", price: "€1,900", amount: 1900, annual: "€1,583", annualAmount: 1583, was: "€2,200", period: "per site per month", features: ["Unlimited tags"], cta: { label: "Talk to sales", href: L + "contact/" }, recommended: true }
], estimate: { value: 4, amount: 490, label: "How many lines would run on Starter?", template: "{n} × Starter: €{total} a month", initial: "4 × Starter: €1,960 a month", note: "Prices exclude VAT.", tip: { label: "What counts as a line?", text: "One production line under one controller." } } }, ctx | merge({ index: 101 })) }}

{{ note("carousel", 'On the <a class="' + link + '" href="' + L + 'customers/">customers page</a>: a snapping row; browsers with <code>::scroll-button</code> and <code>::scroll-marker</code> draw previous, next and a dot per card. Ratings are stars for the eye and a sentence for screen readers. No script.') }}
{{ section({ type: "testimonials", variant: "carousel", title: "Carousel and star ratings", items: [
  { quote: "Commissioning took nine days instead of six weeks.", name: "Dana Okafor", role: "Quality lead", company: "Brightline Pharma", rating: 5 },
  { quote: "The safety review was the first one where nobody argued about the PLC code.", name: "Ilse Brandt", role: "HSE manager", company: "Castor Automotive", rating: 5 },
  { quote: "Line leads change recipes themselves now, inside limits we set.", name: "Tom Hale", role: "Plant manager", company: "Alder Foods", rating: 4 },
  { quote: "We read the description, not the ladder.", name: "Farah Al-Amin", role: "Controls engineer", company: "Dune Logistics", rating: 4 }
] }, ctx | merge({ index: 102 })) }}

{{ note("avatars", 'Under the newsletter form on the <a class="' + link + '" href="' + L + 'blog/">blog</a> and the newsletter page.') }}
{{ section({ type: "newsletter", title: "Avatar stack", form: { action: L + "newsletter/thank-you/", submit: "Subscribe", privacyHref: L + "legal/privacy/" }, readers: { names: ["Priya Natarajan", "Mei Chen", "Dana Okafor", "Jonas Weber"], text: "Read by 1,400 engineers every month" } }, ctx | merge({ index: 103 })) }}

{{ note("compare", 'On every <a class="' + link + '" href="' + L + 'customers/alder-foods/">case study</a>. The range input moves one custom property (script); without script the pictures stay split at half. The clip mirrors in Arabic.') }}
{{ section({ type: "before-after", title: "Before and after slider", before: { slug: "alder-foods-hmi-before", alt: "The old operator panel" }, after: { slug: "alder-foods-hmi-after", alt: "The new display" }, caption: "Drag the handle to compare." }, ctx | merge({ index: 104 })) }}

{{ note("map", 'On the <a class="' + link + '" href="' + L + 'about/locations/">locations page</a>: an image map whose circular areas sit on the dots and link to each office. No script.') }}
{{ section({ type: "office-map", title: "Office map", items: [
  { title: "Manchester", href: L + "about/locations/manchester/", address: "4 Canal Street, Manchester M1 3HE", geo: { lat: 53.4794, lng: -2.2453 } },
  { title: "Hamburg", href: L + "about/locations/hamburg/", address: "Speicherstadt 12, 20457 Hamburg", geo: { lat: 53.5438, lng: 9.9861 } },
  { title: "Riyadh", href: L + "about/locations/riyadh/", address: "King Fahd Road, Riyadh", geo: { lat: 24.7136, lng: 46.6753 } }
] }, ctx | merge({ index: 105 })) }}

{{ note("frame", 'On the <a class="' + link + '" href="' + L + 'newsletter/">newsletter page</a>: a same-origin, sandboxed <code>&lt;iframe&gt;</code> over a skeleton.') }}
{{ section({ type: "newsletter-preview", title: "Framed newsletter issue", src: L + "newsletter/preview/", frameTitle: "The October 2026 issue of Line Notes" }, ctx | merge({ index: 106 })) }}

<div class="mx-auto w-full max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
{% call block("launcher", "Contact launcher", 'On pricing, service and industry pages. The round button in the bottom start corner of this page opens it; Escape or a click outside closes it. No script.') %}
<p class="text-sm">It is live on this page: look at the bottom corner on the start side.</p>
{{ contactLauncher(site.contact, locale) }}
{% endcall %}
{% call block("sticky", "Sticky call to action", 'On the <a class="' + link + '" href="' + L + '">home page</a>, on screens under 1024 px: it rises in once the hero has scrolled away and rests above the footer. No script; browsers without scroll-driven animation leave it out. Narrow the window to see the one at the end of this block.') %}
<div class="h-24"></div>
{{ stickyCta(site.cta, locale) }}
{% endcall %}
</div>
