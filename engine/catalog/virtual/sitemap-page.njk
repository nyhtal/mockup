{{ section({ type: "page-header", eyebrow: eyebrow, title: title, lede: lede, breadcrumbs: breadcrumbs }, ctx) }}
{{ section({ type: "sitemap-list", title: ("ui.allPages" | t), groups: collections.all | sitemapGroups(locale) }, ctx | merge({ surface: "bg-surface-alt" })) }}
