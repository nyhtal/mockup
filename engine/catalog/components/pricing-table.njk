{#
  name: pricing-table
  purpose: 2–4 tiers side by side with one recommended (R-SEC-03, R-COL-06).
  anatomy: ul[data-component=pricing-table] > li(tier) > h{level} + price + p + ul(features with check icons) + button
  variants: monthly only (billing toggles need JS and are out of scope)
  states: recommended tier (brand border + badge text "Most popular")
  spacing: grid gap-6 md:gap-8; tier p-6; features space-y-3
  motion: none
  keyboard: one button per tier
  a11y: the recommended tier is marked by visible text, not colour alone; price uses tabular-nums; features are a list
  i18n: prices are preformatted strings with currency code (R-CONT-14)
  content limits: tiers 2–4; features ≤ 8 per tier; tier name ≤ 20 chars
  data: p = { tiers: [{ name, price, period, text, features: [], cta: { label, href }, recommended }] }
#}
{% from "primitives/icon.njk" import icon with context %}
{% from "primitives/badge.njk" import badge with context %}
{% from "primitives/button.njk" import button with context %}
{% from "sections/_shell.njk" import item with context %}
{% macro pricingTable(p, opts={}) %}
{%- set h = "h" + (opts.level or 3) -%}
{%- set cols = p.tiers.length if p.tiers.length <= 4 else 4 -%}
<ul class="grid gap-6 md:gap-8 md:grid-cols-2 lg:grid-cols-{{ cols }}{{ ' reveal-items' if opts.ctx and opts.ctx.reveal }}" data-component="pricing-table">
{%- for tier in p.tiers %}
<li class="flex flex-col rounded-lg border bg-surface-raised p-6 shadow-sm {{ 'border-brand-600' if tier.recommended else 'border-line' }}{{ item(loop.index0, cols, opts.ctx, 'settle' if tier.recommended else '') if opts.ctx }}">
<div class="flex items-center justify-between gap-3">
<{{ h }} class="text-xl font-semibold">{{ tier.name }}</{{ h }}>
{%- if tier.recommended %}{{ badge("ui.mostPopular" | t, { tone: "brand" }) }}{% endif %}
</div>
<p class="mt-4"><span class="text-4xl font-bold tabular-nums">{{ tier.price }}</span>{% if tier.period %} <span class="text-sm text-ink-muted">{{ tier.period }}</span>{% endif %}</p>
{%- if tier.text %}<p class="mt-2 text-sm text-ink-muted">{{ tier.text }}</p>{% endif %}
<ul class="mt-6 space-y-3 text-sm">
{%- for f in tier.features %}
<li class="flex items-start gap-2">{{ icon("check", { size: "size-4", class: "mt-0.5 text-success" }) }}<span>{{ f }}</span></li>
{%- endfor %}
</ul>
<div class="mt-auto pt-8">{{ button(tier.cta.label, { href: tier.cta.href, variant: "primary" if tier.recommended else "secondary", class: "w-full" }) }}</div>
</li>
{%- endfor %}
</ul>
{% endmacro %}
