{#
  name: prose
  purpose: Styles markdown-rendered article bodies through child selectors so legal pages, posts and docs share one typography (R-TYPO-10, R-TYPO-04, R-TYPO-08).
  anatomy: div[data-component=prose] > (rendered html)
  variants: none
  states: none
  spacing: max-w-prose; headings mt-12/mt-8; paragraphs mt-6; lists mt-6 ps-6
  motion: none
  keyboard: links inside
  a11y: headings start at h2 inside a page that already has its h1
  i18n: hyphens-auto for de pages is applied by the page via opts.class
  content limits: none
  data: html, opts = { class }
#}
{% macro prose(html, opts={}) %}
<div class="max-w-prose text-base leading-relaxed [&_h2]:mt-12 [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-balance [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h4]:mt-6 [&_h4]:text-lg [&_h4]:font-semibold [&_p]:mt-6 [&_ul]:mt-6 [&_ul]:list-disc [&_ul]:ps-6 [&_ol]:mt-6 [&_ol]:list-decimal [&_ol]:ps-6 [&_li]:mt-2 [&_a]:text-ink [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-line [&_a:hover]:decoration-brand-600 [&_strong]:font-semibold [&_blockquote]:my-8 [&_blockquote]:border-s-4 [&_blockquote]:border-brand-600 [&_blockquote]:ps-6 [&_blockquote]:text-xl [&_blockquote]:font-medium [&_table]:mt-6 [&_table]:w-full [&_table]:text-sm [&_th]:border-b [&_th]:border-line [&_th]:px-3 [&_th]:py-2 [&_th]:text-start [&_td]:border-b [&_td]:border-line [&_td]:px-3 [&_td]:py-2 [&_img]:mt-6 [&_img]:rounded-lg [&_code]:rounded-sm [&_code]:bg-surface-alt [&_code]:px-1 [&_code]:text-sm [&_pre]:mt-6 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:bg-surface-alt [&_pre]:p-4 [&_hr]:my-12 [&_hr]:border-line{% if opts.class %} {{ opts.class }}{% endif %}" data-component="prose">
{{ html | safe }}
</div>
{% endmacro %}
