{#
  name: tabs
  purpose: Disclosure tabs: an exclusive details group whose summaries sit in a row at md and above (R-COMP-10).
  anatomy: div[data-component=tabs] > details[name] > summary(label) + div(panel)
  variants: none
  states: open (brand underline on the summary)
  spacing: summaries px-4 py-3; panel py-6, full width under the row
  motion: none
  keyboard: Tab between summaries, Enter/Space opens; the first panel starts open (a summary can still close it, which native details allow)
  a11y: no ARIA tab roles; the pattern is announced as disclosures, which screen readers handle natively
  i18n: labels ≤ 18 chars (R-LAY-09)
  content limits: 2–5 tabs
  layout: at md+ the wrapper is a wrapping flex row; details is display:contents so its summary becomes a flex item, and the browser's ::details-content box (styled via the details-content: variant) is ordered last and full width, so the open panel sits under the row in flow
  data: items = [{ label, body (html), open }]; opts = { group }
#}
{% macro tabs(items, opts={}) %}
<div class="md:flex md:flex-wrap md:border-b md:border-line" data-component="tabs">
{%- for item in items %}
<details class="group md:contents md:details-content:order-last md:details-content:w-full md:details-content:border-t md:details-content:border-line" name="{{ opts.group or 'tabs' }}"{% if item.open or (loop.first and not opts.noneOpen) %} open{% endif %}>
<summary class="cursor-pointer list-none border-b-2 border-transparent px-4 py-3 font-medium text-ink-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus group-open:border-brand-600 group-open:text-ink md:-mb-px">{{ item.label }}</summary>
<div class="py-6 text-base leading-relaxed">{{ item.body | safe }}</div>
</details>
{%- endfor %}
</div>
{% endmacro %}
