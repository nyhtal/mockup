{#
  name: search-results
  purpose: Static list of mock results for the search page; the empty state when there are none (R-SEC-11).
  anatomy: div[data-component=search-results] > p(count) + ol > li > h{level} > a + p(excerpt) + p(url)
  variants: none
  states: results | empty (empty-state component)
  spacing: space-y-6
  motion: none
  keyboard: links
  a11y: results are an ordered list; the count is announced as text
  i18n: ui.resultsFor
  content limits: ≤ 12 per page
  data: r = { query, items: [{ title, href, excerpt }] }
#}
{% from "components/empty-state.njk" import emptyState with context %}
{% macro searchResults(r, opts={}) %}
{%- set h = "h" + (opts.level or 2) -%}
<div data-component="search-results">
{%- if r.items.length %}
<p class="text-sm text-ink-muted">{{ ("ui.resultsFor" | t) | replace("{count}", r.items.length) | replace("{query}", r.query) }}</p>
<ol class="mt-6 space-y-6">
{%- for item in r.items %}
<li>
<{{ h }} class="text-xl font-semibold"><a href="{{ item.href }}" class="hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ item.title }}</a></{{ h }}>
<p class="mt-1 text-base leading-relaxed text-ink-muted">{{ item.excerpt }}</p>
<p class="mt-1 text-sm text-ink-muted">{{ item.href }}</p>
</li>
{%- endfor %}
</ol>
{%- else %}
{{ emptyState({ icon: "search", title: ("ui.noResultsTitle" | t), text: ("ui.noResultsText" | t), cta: r.cta }) }}
{%- endif %}
</div>
{% endmacro %}
