{#
  name: pagination
  purpose: Page links for index pages at 12 items per page (R-PAGE-11).
  anatomy: nav[aria-label] > ul > li(prev) + li(numbers)* + li(next)
  variants: none
  states: current page aria-current="page" (brand); disabled prev/next rendered as text
  spacing: gap-1; items size-11
  motion: none
  keyboard: links
  a11y: nav labelled; prev/next have visible text plus icons; current page is a span
  i18n: ui.pagination, ui.previous, ui.next; arrows flip in RTL
  content limits: ≤ 7 numbered links; use ellipsis text "…" beyond
  data: p = { current, total, href(n) → url: pass hrefs as p.pages [{ n, url }] plus p.prev/p.next urls }
#}
{% from "primitives/icon.njk" import icon with context %}
{% macro pagination(p) %}
<nav aria-label="{{ 'ui.pagination' | t }}" data-component="pagination">
<ul class="flex flex-wrap items-center gap-1">
<li>{% if p.prev %}<a href="{{ p.prev }}" class="inline-flex min-h-11 items-center gap-1 rounded-md px-3 text-sm font-medium text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ icon("chevron-left", { size: "size-4", class: "rtl:-scale-x-100" }) }}{{ "ui.previous" | t }}</a>{% else %}<span class="inline-flex min-h-11 items-center gap-1 px-3 text-sm text-ink-muted">{{ icon("chevron-left", { size: "size-4", class: "rtl:-scale-x-100" }) }}{{ "ui.previous" | t }}</span>{% endif %}</li>
{%- for page in p.pages %}
<li>{% if page.n == p.current %}<span aria-current="page" class="inline-flex size-11 items-center justify-center rounded-md bg-brand-600 text-sm font-medium tabular-nums text-ink-inverse">{{ page.n }}</span>{% elif page.n == "…" %}<span class="inline-flex size-11 items-center justify-center text-sm text-ink-muted">…</span>{% else %}<a href="{{ page.url }}" class="inline-flex size-11 items-center justify-center rounded-md text-sm font-medium tabular-nums text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ page.n }}</a>{% endif %}</li>
{%- endfor %}
<li>{% if p.next %}<a href="{{ p.next }}" class="inline-flex min-h-11 items-center gap-1 rounded-md px-3 text-sm font-medium text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ "ui.next" | t }}{{ icon("chevron-right", { size: "size-4", class: "rtl:-scale-x-100" }) }}</a>{% else %}<span class="inline-flex min-h-11 items-center gap-1 px-3 text-sm text-ink-muted">{{ "ui.next" | t }}{{ icon("chevron-right", { size: "size-4", class: "rtl:-scale-x-100" }) }}</span>{% endif %}</li>
</ul>
</nav>
{% endmacro %}
