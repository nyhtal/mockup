{#
  name: card
  purpose: The repeated item of every grid: services, case studies, team, offices, downloads, events, jobs, integrations, articles (R-COMP-06, R-COMP-07, R-COMP-08).
  anatomy: li|article[data-component=card data-variant] > (media) + body(eyebrow/meta + h{level} > a + text + footer)
  variants: service (icon, title, text, link) | case-study (wordmark, metric, quote) | team (avatar, name, role) | office (city, address, phone) | download (type badge, pages, title) | event (date block, type, location) | job (title, team, location, type) | integration (icon tile, name, text) | article (picture, eyebrow, title, date, excerpt)
  states: rest (shadow-sm), hover (lift + shadow-md), focus-within (ring on the link)
  spacing: p-6 (comfortable) / p-4 (compact density); internal mt-2/mt-4 steps
  motion: motion-safe:hover:-translate-y-0.5 with transition-transform duration-150
  keyboard: the title link is the only focusable element; the whole card is clickable via after:absolute after:inset-0
  a11y: heading level is a parameter (default 3); link text is the title; icons aria-hidden; dates in <time>
  i18n: dates and phone numbers are preformatted strings from content; metric values use tabular-nums
  content limits: title ≤ 70 chars, text ≤ 40 words, metric label ≤ 4 words
  data: c = { variant, href, title, text, eyebrow, icon, name, role, metricValue, metricLabel, quote, company, city, address, phone, type, pages, date, dateIso, location, team, image: {slug, ratio, alt}, logo }
#}
{% from "primitives/icon.njk" import icon with context %}
{% from "primitives/avatar.njk" import avatar with context %}
{% from "primitives/wordmark.njk" import wordmark with context %}
{% from "primitives/badge.njk" import badge with context %}
{% from "primitives/picture.njk" import picture with context %}
{% macro card(c, opts={}) %}
{%- set tag = opts.tag or "li" -%}
{%- set h = "h" + (opts.level or 3) -%}
{%- set variant = c.variant or "service" -%}
{%- set pad = "p-4" if opts.density == "compact" else "p-6" -%}
{%- set link = "text-ink after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus hover:underline underline-offset-4" -%}
<{{ tag }} class="relative flex flex-col rounded-lg border border-line bg-surface-raised {{ pad }} shadow-sm motion-safe:transition-transform motion-safe:duration-150 motion-safe:hover:-translate-y-0.5 hover:shadow-md" data-component="card" data-variant="{{ variant }}">
{%- if variant == "article" and c.image %}
<div class="-mx-6 -mt-6 mb-6 overflow-hidden rounded-t-lg">{{ picture(c.image, { sizes: "(min-width: 48rem) 33vw, 100vw", class: "aspect-video w-full object-cover" }) }}</div>
{%- endif %}
{%- if variant == "service" or variant == "integration" %}
<span class="mb-4 inline-flex size-12 items-center justify-center rounded-md bg-brand-100 text-brand-800">{{ icon(c.icon or "zap", { size: "size-6" }) }}</span>
{%- endif %}
{%- if variant == "case-study" %}
<div class="mb-4 text-ink-muted">{{ wordmark(c.company, { variant: "mono" }) }}</div>
<p class="text-4xl font-bold tabular-nums text-ink-brand">{{ c.metricValue }}</p>
<p class="text-sm text-ink-muted">{{ c.metricLabel }}</p>
{%- endif %}
{%- if variant == "team" %}
<div class="mb-4">{{ avatar(c.name) }}</div>
{%- endif %}
{%- if variant == "download" %}
<div class="mb-4 flex items-center gap-2">{{ badge(c.type or "PDF", { tone: "brand" }) }}{% if c.pages %}<span class="text-sm text-ink-muted">{{ c.pages }}</span>{% endif %}</div>
{%- endif %}
{%- if variant == "event" %}
<p class="mb-4 text-sm font-medium text-ink-brand"><time datetime="{{ c.dateIso }}">{{ c.date }}</time>{% if c.type %} · {{ c.type }}{% endif %}</p>
{%- endif %}
{%- if c.eyebrow and variant != "event" %}
<p class="mb-2 text-sm font-medium uppercase tracking-wide text-ink-brand">{{ c.eyebrow }}</p>
{%- endif %}
{%- if variant == "article" and c.date %}
<p class="mb-2 text-sm text-ink-muted"><time datetime="{{ c.dateIso }}">{{ c.date }}</time></p>
{%- endif %}
<{{ h }} class="text-xl font-semibold">{% if c.href %}<a href="{{ c.href }}" class="{{ link }}">{{ c.title or c.name }}</a>{% else %}{{ c.title or c.name }}{% endif %}</{{ h }}>
{%- if variant == "team" and c.role %}
<p class="mt-1 text-sm text-ink-muted">{{ c.role }}</p>
{%- endif %}
{%- if variant == "case-study" and c.quote %}
<p class="mt-2 text-base leading-relaxed text-ink-muted">“{{ c.quote }}”</p>
{%- elif c.text %}
<p class="mt-2 text-base leading-relaxed text-ink-muted">{{ c.text }}</p>
{%- endif %}
{%- if variant == "office" %}
<address class="mt-2 text-base not-italic leading-relaxed text-ink-muted">{{ c.address }}<br>{% if c.phone %}<a href="tel:{{ c.phone | replace(' ', '') }}" class="relative inline-block py-1 hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ c.phone }}</a>{% endif %}</address>
{%- endif %}
{%- if variant == "job" %}
<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-muted">
{%- if c.team %}<li class="inline-flex items-center gap-1">{{ icon("users", { size: "size-4" }) }}{{ c.team }}</li>{% endif %}
{%- if c.location %}<li class="inline-flex items-center gap-1">{{ icon("map-pin", { size: "size-4" }) }}{{ c.location }}</li>{% endif %}
{%- if c.type %}<li class="inline-flex items-center gap-1">{{ icon("clock", { size: "size-4" }) }}{{ c.type }}</li>{% endif %}
</ul>
{%- endif %}
{%- if variant == "event" and c.location %}
<p class="mt-3 inline-flex items-center gap-1 text-sm text-ink-muted">{{ icon("map-pin", { size: "size-4" }) }}{{ c.location }}</p>
{%- endif %}
{%- if c.href and (variant == "service" or variant == "integration" or variant == "download") %}
<p class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium text-ink-brand" aria-hidden="true">{{ c.cta or (("ui.download" | t) if variant == "download" else ("ui.readMore" | t)) }}{{ icon("arrow-right", { size: "size-4", class: "rtl:-scale-x-100" }) }}</p>
{%- endif %}
</{{ tag }}>
{% endmacro %}
