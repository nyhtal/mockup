{#
  name: announcement-bar
  purpose: One-line notice above the header (launch, event, outage) (R-SEC-05 does not count it as a CTA).
  anatomy: div[data-component=announcement-bar] > p > text + a
  variants: none
  states: none (no dismiss without JS; the owner removes it)
  spacing: py-2, container inside
  motion: none
  keyboard: the link only
  a11y: plain text and a link; brand background with ink-inverse text meets 4.5:1
  i18n: text and link label from content
  content limits: text ≤ 12 words, link label ≤ 4 words
#}
{% macro announcementBar(a, locale) %}
<div class="bg-brand-700 text-sm text-ink-inverse" data-component="announcement-bar">
<p class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-2 sm:px-6 lg:px-8"><span>{{ a.text }}</span><a href="/{{ locale }}{{ a.href }}" class="font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ a.label }}</a></p>
</div>
{% endmacro %}
