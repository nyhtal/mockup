{#
  name: steps
  purpose: Numbered process, 3–5 steps (R-SEC-03).
  anatomy: ol[data-component=steps] > li > span(number disc) + h{level} + p
  variants: vertical (default) | horizontal (md: grid columns)
  states: none
  spacing: gap-8; disc size-10
  motion: none
  keyboard: none
  a11y: ordered list carries the numbering; the disc number is aria-hidden duplicate
  i18n: numbers are Latin digits by default; Arabic-Indic when site.numberingSystem says so
  content limits: title ≤ 6 words; description ≤ 25 words
  data: items = [{ title, text }]; opts = { level, variant }
#}
{% from "sections/_shell.njk" import stagger, pop with context %}
{% macro steps(items, opts={}) %}
{%- set h = "h" + (opts.level or 3) -%}
<ol class="grid gap-8 {{ 'md:grid-cols-' + (items.length if items.length <= 5 else 5) if opts.variant == 'horizontal' }}{{ ' reveal-items' if opts.reveal }}" data-component="steps" data-variant="{{ opts.variant or 'vertical' }}">
{%- for item in items %}
<li class="flex gap-4 {{ 'md:flex-col' if opts.variant == 'horizontal' }}{{ stagger(loop.index0, 'start') if opts.reveal }}">
<span aria-hidden="true" class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-600 font-semibold tabular-nums text-ink-inverse{{ pop(opts.ctx, (loop.index0 if loop.index0 < 7 else 7) * 70) if opts.ctx }}">{{ loop.index }}</span>
<div>
<{{ h }} class="text-lg font-semibold">{{ item.title }}</{{ h }}>
<p class="mt-1 text-base leading-relaxed text-ink-muted">{{ item.text }}</p>
</div>
</li>
{%- endfor %}
</ol>
{% endmacro %}
