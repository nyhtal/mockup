{#
  name: share-links
  purpose: Share controls for articles. In the mockup they are placeholders: no external share URLs ship (R-HTML-16, R-PERF-06).
  anatomy: div[data-component=share-links] > p(label) + ul > li > a[mailto] | button
  variants: none
  states: hover, focus-visible
  spacing: gap-2
  motion: none
  keyboard: all controls focusable
  a11y: icon buttons carry sr-only names; the email link is a real mailto
  i18n: ui.share, ui.shareByEmail, ui.copyLink
  content limits: none
  data: s = { url, title }
#}
{% from "primitives/icon.njk" import icon with context %}
{% macro shareLinks(s) %}
<div class="flex flex-wrap items-center gap-3" data-component="share-links">
<p class="text-sm font-medium text-ink-muted">{{ "ui.share" | t }}</p>
<ul class="flex gap-2">
<li><a href="mailto:?subject={{ s.title | urlencode }}&amp;body={{ s.url | urlencode }}" class="inline-flex size-11 items-center justify-center rounded-md border border-line-strong text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ icon("mail") }}<span class="sr-only">{{ "ui.shareByEmail" | t }}</span></a></li>
<li><button type="button" class="inline-flex size-11 items-center justify-center rounded-md border border-line-strong text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" disabled>{{ icon("link") }}<span class="sr-only">{{ "ui.copyLink" | t }}</span></button></li>
<li><button type="button" class="inline-flex size-11 items-center justify-center rounded-md border border-line-strong text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" disabled>{{ icon("share-2") }}<span class="sr-only">{{ "ui.shareElsewhere" | t }}</span></button></li>
</ul>
</div>
{% endmacro %}
