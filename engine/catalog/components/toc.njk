{#
  name: toc
  purpose: In-page table of contents for long articles and docs.
  anatomy: nav[aria-label] > h2 + ol > li > a[href=#id]
  variants: none
  states: hover
  spacing: sticky top-20 on lg; text-sm; space-y-2
  motion: none
  keyboard: links; targets clear the sticky header via html scroll-pt-20 (R-LAY-07)
  a11y: labelled nav; heading "On this page"
  i18n: ui.onThisPage
  content limits: ≤ 12 entries, h2 and h3 only
  data: headings = [{ id, text, level }]
#}
{% macro toc(headings) %}
<nav aria-label="{{ 'ui.onThisPage' | t }}" class="lg:sticky lg:top-20" data-component="toc">
<h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">{{ "ui.onThisPage" | t }}</h2>
<ol class="mt-3 space-y-2 text-sm">
{%- for h in headings %}
<li class="{{ 'ps-4' if h.level == 3 }}"><a href="#{{ h.id }}" class="text-ink-muted hover:text-ink hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ h.text }}</a></li>
{%- endfor %}
</ol>
</nav>
{% endmacro %}
