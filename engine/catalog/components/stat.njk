{#
  name: stat
  purpose: One headline figure with its label (R-TYPO-09, R-CONT-11).
  anatomy: div[data-component=stat] > p.value > numeral (the counting triple when the section reveals) + p.label (+ badge trend)
  variants: default | inverse (on brand backgrounds: display size, numerals in a light gradient that ends in accent-200, the evidence colour)
  states: none
  spacing: value then mt-1 label
  motion: on a revealing section the value counts from 0 once it scrolls into view (enhance.js behaviour 3, R-MOT-10); the build-time text is restored at the end, so the figure is complete without JS and under reduced motion
  keyboard: none
  a11y: value and label are plain text in reading order; the count changes text only, never size or position
  i18n: the value is preformatted per locale by the build (R-I18N-07); label ≤ 4 words
  content limits: value ≤ 8 chars; 3–4 stats per section (R-SEC-03); opts = { inverse, count, settle (expressive), trendTone }
#}
{% from "primitives/badge.njk" import badge with context %}
{% from "primitives/numeral.njk" import numeral with context %}
{#- <data value>: the figure's number, or s.dataValue when the text holds more than one ("2 of 3" is 0.667); s.meter adds a <meter> (to-do 6). -#}
{% macro stat(s, opts={}) %}
{%- set fig = s.value | figure -%}
<div data-component="stat" data-variant="{{ 'inverse' if opts.inverse else 'default' }}">
<p class="font-bold tabular-nums {{ 'text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-ink-inverse bg-linear-to-br from-ink-inverse to-accent-200 bg-clip-text supports-[background-clip:text]:text-transparent' if opts.inverse else 'text-4xl text-ink' }}">{% if fig %}<data value="{{ s.dataValue or fig.number }}">{% endif %}{{ numeral(s.value, { count: opts.count, settle: opts.settle }) }}{% if fig %}</data>{% endif %}</p>
<p class="mt-1 text-sm {{ 'text-ink-inverse/80' if opts.inverse else 'text-ink-muted' }}">{{ s.label }}</p>
{%- if s.meter %}<meter min="0" max="{{ s.meter.max or 100 }}" value="{{ s.meter.value }}" optimum="{{ s.meter.max or 100 }}" aria-hidden="true" class="mt-3 block h-2 w-full max-w-48">{{ s.value }}</meter>{% endif %}
{%- if s.trend %}<p class="mt-2">{{ badge(s.trend, { tone: s.trendTone or "success" }) }}</p>{% endif %}
</div>
{% endmacro %}
