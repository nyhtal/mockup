{#
  name: nav-menu
  purpose: Primary navigation for lg+ screens with popover mega menus (R-COMP-09, R-A11Y-06).
  anatomy: nav[aria-label] > ul > li > a | button[popovertarget] + div[popover]#menu-n > ul > li > a + p
  variants: none
  states: current page (aria-current + brand text), hover, focus-visible, menu open (popover)
  spacing: gap-1 between items; panel py-8, columns gap-8
  motion: panel enters with the R-MOT-06 popover pattern
  keyboard: Tab through items; Enter/Space opens a menu; Escape closes it and focus returns to the button (native)
  a11y: nav labelled; the button's expanded state is exposed by the Popover API; panels are full-width under the header so no anchor positioning is needed
  i18n: labels via i18n keys; hrefs are prefixed with the locale
  content limits: ≤ 7 top-level items, labels ≤ 18 chars; a menu holds 2–8 children with ≤ 12-word descriptions
#}
{% macro navMenu(items, locale, currentUrl) %}
<nav aria-label="{{ 'nav.primary' | t }}" class="hidden lg:block" data-component="nav-menu">
<ul class="flex items-center gap-1">
{%- for item in items %}
{%- set href = "/" + locale + item.href -%}
<li>
{%- if item.children %}
<button type="button" popovertarget="menu-{{ loop.index }}" class="inline-flex min-h-11 items-center gap-1 rounded-md px-3 text-sm font-medium text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150">{{ item.key | t }}<svg aria-hidden="true" class="size-4 shrink-0"><use href="#i-chevron-down"></use></svg></button>
<div popover id="menu-{{ loop.index }}" class="fixed inset-x-0 top-16 bottom-auto m-0 w-full max-w-none border-0 border-b border-line bg-surface-raised p-0 text-ink shadow-md opacity-0 open:opacity-100 motion-safe:-translate-y-2 motion-safe:open:translate-y-0 motion-safe:transition-discrete motion-safe:transition-[opacity,transform,display,overlay] motion-safe:duration-200 motion-safe:ease-out motion-safe:starting:open:opacity-0 motion-safe:starting:open:-translate-y-2">
<ul class="mx-auto grid w-full max-w-7xl gap-6 px-4 py-8 sm:px-6 md:grid-cols-2 lg:grid-cols-3 lg:px-8">
{%- for child in item.children %}
<li><a href="/{{ locale }}{{ child.href }}" class="block rounded-lg p-4 hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150"{% if currentUrl == "/" + locale + child.href %} aria-current="page"{% endif %}><span class="block font-medium">{{ child.key | t }}</span>{% if child.descKey %}<span class="mt-1 block text-sm text-ink-muted">{{ child.descKey | t }}</span>{% endif %}</a></li>
{%- endfor %}
</ul>
</div>
{%- else %}
<a href="{{ href }}" class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150 {{ 'text-ink-brand' if currentUrl == href else 'text-ink' }}"{% if currentUrl == href %} aria-current="page"{% endif %}>{{ item.key | t }}</a>
{%- endif %}
</li>
{%- endfor %}
</ul>
</nav>
{% endmacro %}
