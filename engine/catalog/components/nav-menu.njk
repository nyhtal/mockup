{#
  name: nav-menu
  purpose: Primary navigation for lg+ screens with popover mega menus (R-COMP-09, R-A11Y-06).
  anatomy: nav[aria-label] > ul > li > a | button[popovertarget] + div[popover]#menu-n > ul > li > a + p
  variants: wide panel (default: full width under the header, one column per link, two to four) | compact list (item.layout = "list": a w-72 single-column dropdown anchored under its button with CSS anchor positioning, flipping inline when it would leave the window; without anchor-positioning support it sits under the header at the inline end)
  states: current page (aria-current + brand text), hover, focus-visible, menu open (popover)
  spacing: gap-1 between items, px-2 at lg and px-3 at xl (the lg bar holds the logo lockup, four German items and three actions in 960 px); panel py-8, columns gap-8
  motion: panel enters with the R-MOT-06 popover pattern
  keyboard: Tab through items; Enter/Space opens a menu; Escape closes it and focus returns to the button (native)
  a11y: nav labelled; the button's expanded state is exposed by the Popover API; the wide panels hang from the header's bottom edge (top: anchor(--header bottom)) so they open below the links even while the announcement bar pushes the header down; without anchor positioning they sit 64 px from the window top
  i18n: labels via i18n keys; hrefs are prefixed with the locale
  content limits: ≤ 7 top-level items, labels ≤ 18 chars; a menu holds 2–8 children with ≤ 12-word descriptions
#}
{% macro navMenu(items, locale, currentUrl) %}
<nav aria-label="{{ 'nav.primary' | t }}" class="hidden lg:block" data-component="nav-menu">
<ul class="flex items-center gap-1">
{%- for item in items %}
{%- set href = "/" + locale + item.href -%}
<li>
{%- if item.children %}
{%- set list = item.layout == "list" -%}
<button type="button" popovertarget="menu-{{ loop.index }}" class="{{ '[anchor-name:--menu-' + loop.index + '] ' if list }}inline-flex min-h-11 items-center gap-1 whitespace-nowrap rounded-md px-2 xl:px-3 text-sm font-medium text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150">{{ item.key | t }}<svg aria-hidden="true" class="size-4 shrink-0"><use href="#i-chevron-down"></use></svg></button>
{%- set motion = "opacity-0 open:opacity-100 motion-safe:-translate-y-2 motion-safe:open:translate-y-0 motion-safe:transition-discrete motion-safe:transition-[opacity,translate,scale,display,overlay] motion-safe:duration-200 motion-safe:ease-out motion-safe:starting:open:opacity-0 motion-safe:starting:open:-translate-y-2" -%}
{%- if list %}
{#- Compact dropdown: one column under its button (CSS anchor positioning; flips to the other side if it would leave the window). Without anchor positioning it sits under the header at the inline end of the page. -#}
<div popover id="menu-{{ loop.index }}" class="fixed top-16 end-4 start-auto bottom-auto m-0 w-72 rounded-lg border border-line bg-surface-raised p-2 text-ink shadow-md supports-[position-area:block-end]:inset-auto supports-[position-area:block-end]:mt-2 supports-[position-area:block-end]:[position-anchor:--menu-{{ loop.index }}] supports-[position-area:block-end]:[position-area:block-end_span-inline-end] supports-[position-area:block-end]:[position-try-fallbacks:flip-inline] {{ motion }}">
<ul>
{%- for child in item.children %}
<li><a href="/{{ locale }}{{ child.href }}" class="block rounded-md px-3 py-2.5 hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150 aria-[current=page]:text-ink-brand"{% if currentUrl == "/" + locale + child.href %} aria-current="page"{% endif %}><span class="block text-sm font-medium">{{ child.key | t }}</span>{% if child.descKey %}<span class="mt-0.5 block text-sm text-ink-muted">{{ child.descKey | t }}</span>{% endif %}</a></li>
{%- endfor %}
</ul>
</div>
{%- else %}
{#- Wide panel: one column per link (two to four) so the links sit on one row and line up. -#}
{%- set n = item.children.length if item.children.length <= 4 else 4 -%}
<div popover id="menu-{{ loop.index }}" class="fixed inset-x-0 top-16 bottom-auto m-0 w-full max-w-none border-0 border-b border-line bg-surface-raised p-0 text-ink shadow-md supports-[position-area:block-end]:[top:anchor(--header_bottom)] {{ motion }}">
<ul class="mx-auto grid w-full max-w-7xl gap-6 px-4 py-8 sm:px-6 lg:px-8 {{ 'grid-cols-4' if n == 4 else ('grid-cols-3' if n == 3 else 'grid-cols-2') }}">
{%- for child in item.children %}
<li><a href="/{{ locale }}{{ child.href }}" class="block h-full rounded-lg p-4 hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150"{% if currentUrl == "/" + locale + child.href %} aria-current="page"{% endif %}><span class="block font-medium">{{ child.key | t }}</span>{% if child.descKey %}<span class="mt-1 block text-sm text-ink-muted">{{ child.descKey | t }}</span>{% endif %}</a></li>
{%- endfor %}
</ul>
</div>
{%- endif %}
{%- else %}
<a href="{{ href }}" class="relative inline-flex min-h-11 items-center whitespace-nowrap px-2 xl:px-3 text-sm font-medium after:absolute after:inset-x-2 xl:after:inset-x-3 after:bottom-2 after:h-0.5 after:rounded-full after:bg-brand-600 after:scale-x-0 after:origin-left rtl:after:origin-right motion-safe:after:transition-transform motion-safe:after:duration-150 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150 hover:text-ink-brand {{ 'text-ink-brand' if currentUrl == href else 'text-ink' }}"{% if currentUrl == href %} aria-current="page"{% endif %}>{{ item.key | t }}</a>
{%- endif %}
</li>
{%- endfor %}
</ul>
</nav>
{% endmacro %}
