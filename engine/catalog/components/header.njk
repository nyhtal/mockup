{#
  name: header
  purpose: Site header: logo, primary navigation, locale switcher, search, primary CTA, mobile menu button (R-LAY-07, R-SEC-05).
  anatomy: header[sticky] > div.container > a(logo lockup: mark + wordmark) + nav-menu + div(actions: locale-switcher, search link, sound toggle at xl, CTA, menu button)
  variants: none in v1 (a transparent-over-hero variant was removed: its children hard-code ink colours and nothing offsets main; add it with the R-COL-08 overlay when a page needs it)
  states: current page in nav; menus open via popovers
  spacing: h-16, container, gap-4 (sm: gap-6); below sm only the wordmark (h-7) and the menu button show, so the bar fits 320 px (R-LAY-05): search and languages live in the drawer there; at lg the nav (px-2 items), an icon-only switcher, search and a non-wrapping CTA (px-4) share 960 px with the lockup (size-7 mark, h-6 wordmark); nav labels, the sound toggle, px-3 items and the larger lockup return at xl
  motion: none on the bar itself (R-MOT-11); popovers animate; from the standard level a one-pixel brand-to-accent hairline on the bar's bottom edge grows from the start edge with the page's scroll (R-MOT-08), rendered only under motion-safe and scroll-driven support. It is absolute, not fixed: the bar's backdrop-filter makes it the containing block of fixed descendants anyway
  keyboard: logo → nav items → locale → search → sound (xl) → CTA → menu button; below xl the sound toggle is in the footer (and in the drawer below lg), because the lg bar has no room for a fifth action in German
  a11y: one header landmark; the logo link names the site; the menu button has sr-only text; the CTA is hidden below lg (it repeats in the drawer)
  i18n: CTA and nav labels via keys; the drawer slides from the end edge
  content limits: ≤ 7 nav items (R-LAY-09 says collapse at lg)
#}
{% from "primitives/logo.njk" import logo with context %}
{% from "components/sound-toggle.njk" import soundToggle with context %}
{% from "components/nav-menu.njk" import navMenu with context %}
{% from "components/locale-switcher.njk" import localeSwitcher with context %}
{% macro header(site, locale, currentUrl, alternates, opts={}) %}
<header class="sticky top-0 z-10 h-16 border-b border-line bg-surface/90 backdrop-blur{% if flair and flair.progress %} before:pointer-events-none before:absolute before:inset-x-0 before:-bottom-px before:hidden before:h-px before:origin-left rtl:before:origin-right before:bg-linear-to-r before:from-brand-600 before:to-accent-600 motion-safe:sda:before:block motion-safe:sda:before:animate-progress motion-safe:sda:before:[animation-timeline:scroll(root)]{% endif %} after:pointer-events-none after:absolute after:inset-0 after:-z-10 after:shadow-md after:shadow-ink/10 after:opacity-0 motion-safe:sda:after:animate-fade motion-safe:sda:after:[animation-timeline:scroll()] motion-safe:sda:after:[animation-range:0_12rem] print:static print:border-0" data-component="header">
<div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:gap-6 sm:px-6 lg:gap-3 lg:px-8 xl:gap-6">
<a href="/{{ locale }}/" class="inline-flex shrink-0 items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ logo(site.name) }}</a>
{{ navMenu(site.nav, locale, currentUrl) }}
<div class="flex items-center gap-1">
{{ localeSwitcher(alternates, locale, { class: "hidden sm:block" }) }}
{%- if site.hasSearch %}
<a href="/{{ locale }}/search/" class="hidden size-11 sm:inline-flex items-center justify-center rounded-md text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"><svg aria-hidden="true" class="size-5"><use href="#i-search"></use></svg><span class="sr-only">{{ "ui.search" | t }}</span></a>
{%- endif %}
{{ soundToggle({ class: "hidden xl:inline-flex" }) }}
{%- if site.cta %}
<a href="/{{ locale }}{{ site.cta.href }}" class="hidden min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-md bg-brand-600 px-4 xl:px-5 font-medium text-ink-inverse hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus group motion-safe:transition-[color,background-color,border-color,translate,scale] motion-safe:duration-150 motion-safe:hover:-translate-y-px hover:shadow-md active:translate-y-0 motion-safe:active:scale-[0.98] lg:inline-flex">{{ site.cta.key | t }}<svg aria-hidden="true" class="size-4 shrink-0 motion-safe:transition-transform motion-safe:duration-150 group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5"><use href="#i-arrow-right"></use></svg></a>
{%- endif %}
<button type="button" popovertarget="drawer" class="inline-flex size-11 items-center justify-center rounded-md text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus lg:hidden"><svg aria-hidden="true" class="size-6"><use href="#i-menu"></use></svg><span class="sr-only">{{ "ui.menu" | t }}</span></button>
</div>
</div>
</header>
{% endmacro %}
