{#
  name: header
  purpose: Site header: logo, primary navigation, locale switcher, search, primary CTA, mobile menu button (R-LAY-07, R-SEC-05).
  anatomy: header[sticky] > div.container > a(logo) + nav-menu + div(actions: locale-switcher, search link, CTA, menu button)
  variants: default (surface with blur) | transparent (over a media hero: absolute, no border; opts.variant)
  states: current page in nav; menus open via popovers
  spacing: h-16, container, gap-6
  motion: none on the bar itself (R-MOT-11); popovers animate
  keyboard: logo → nav items → locale → search → CTA → menu button
  a11y: one header landmark; the logo link names the site; the menu button has sr-only text; the CTA is hidden below lg (it repeats in the drawer)
  i18n: CTA and nav labels via keys; the drawer slides from the end edge
  content limits: ≤ 7 nav items (R-LAY-09 says collapse at lg)
#}
{% from "primitives/wordmark.njk" import wordmark %}
{% from "components/nav-menu.njk" import navMenu %}
{% from "components/locale-switcher.njk" import localeSwitcher %}
{% macro header(site, locale, currentUrl, alternates, opts={}) %}
<header class="{{ 'absolute inset-x-0 top-0 z-10 h-16 text-ink-inverse' if opts.variant == 'transparent' else 'sticky top-0 z-10 h-16 border-b border-line bg-surface/90 backdrop-blur' }} print:static print:border-0" data-component="header" data-variant="{{ opts.variant or 'default' }}">
<div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
<a href="/{{ locale }}/" class="inline-flex shrink-0 items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ wordmark(site.name) }}</a>
{{ navMenu(site.nav, locale, currentUrl) }}
<div class="flex items-center gap-1">
{{ localeSwitcher(alternates, locale) }}
{%- if site.hasSearch %}
<a href="/{{ locale }}/search/" class="inline-flex size-11 items-center justify-center rounded-md text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"><svg aria-hidden="true" class="size-5"><use href="#i-search"></use></svg><span class="sr-only">{{ "ui.search" | t }}</span></a>
{%- endif %}
{%- if site.cta %}
<a href="/{{ locale }}{{ site.cta.href }}" class="hidden min-h-11 items-center justify-center gap-2 rounded-md bg-brand-600 px-5 font-medium text-ink-inverse hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:transition-colors motion-safe:duration-150 lg:inline-flex">{{ site.cta.key | t }}</a>
{%- endif %}
<button type="button" popovertarget="drawer" class="inline-flex size-11 items-center justify-center rounded-md text-ink hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus lg:hidden"><svg aria-hidden="true" class="size-6"><use href="#i-menu"></use></svg><span class="sr-only">{{ "ui.menu" | t }}</span></button>
</div>
</div>
</header>
{% endmacro %}
