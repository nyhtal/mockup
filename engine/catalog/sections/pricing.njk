{#
  name: pricing
  purpose: Pricing tiers (R-SEC-03: 2–4).
  anatomy: shell > pricing-table
  variants: none
  states: per table
  spacing: per component
  motion: reveals
  keyboard: tier buttons
  a11y: per component
  i18n: prices preformatted
  content limits: 2–4 tiers
  data: s = { eyebrow, title, lede, tiers: [...] }
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "components/pricing-table.njk" import pricingTable with context %}
{% macro render(s, ctx) %}
{% call shell("pricing", s, ctx, { itemsReveal: ctx.reveal }) %}
{{ pricingTable({ tiers: s.tiers }, { ctx: ctx }) }}
{% endcall %}
{% endmacro %}
