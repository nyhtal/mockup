{#
  name: comparison
  purpose: Feature comparison table section.
  anatomy: shell > comparison-table
  variants: none
  states: per table
  spacing: per component
  motion: reveals
  keyboard: scroll wrapper
  a11y: per component
  i18n: none
  content limits: ≤ 5 columns, ≤ 15 rows
  data: s = { eyebrow, title, lede, table: { caption, columns, rows } }
#}
{% from "sections/_shell.njk" import shell %}
{% from "components/comparison-table.njk" import comparisonTable %}
{% macro render(s, ctx) %}
{% call shell("comparison", s, ctx) %}
{{ comparisonTable(s.table) }}
{% endcall %}
{% endmacro %}
