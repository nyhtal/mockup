{#
  name: testimonials
  purpose: One, three or a scrollable row of customer quotes (R-SEC-03, R-COMP-11).
  anatomy: shell > testimonial (single) | ul.grid (grid) | ul.snap carousel (carousel)
  variants: single | grid | carousel
  states: none
  spacing: grid gap-6 md:gap-8; carousel gap-6 with snap-x
  motion: grid cards settle from 96 % with a stagger, the single quote settles as one framed object (DESIGN §3); the carousel never autoplays
  keyboard: carousel items are reachable because the figure contains no controls; the scroll container is focusable
  a11y: figures with figcaptions; carousel is a list in a focusable scroll region
  i18n: none
  content limits: single 1, grid 3, carousel ≤ 6
  data: s = { eyebrow, title, items: [testimonial data], variant }
#}
{% from "sections/_shell.njk" import shell, item with context %}
{% from "components/testimonial.njk" import testimonial with context %}
{% macro render(s, ctx) %}
{%- set variant = s.variant or ("single" if s.items.length == 1 else "grid") -%}
{% call shell("testimonials", s, ctx, { itemsReveal: ctx.reveal and variant != "single", center: variant == "single", kind: "scale" }) %}
{%- if variant == "single" %}
{{ testimonial(s.items[0]) }}
{%- elif variant == "carousel" %}
{#- Carousel (to-do 7b): the list scrolls and snaps; ::scroll-button and ::scroll-marker add controls where supported. Focusable so the keyboard can scroll it. -#}
<div class="relative">
<ul class="carousel" tabindex="0" aria-label="{{ s.title or ('ui.testimonials' | t) }}" data-prev="{{ 'ui.previous' | t }}" data-next="{{ 'ui.next' | t }}">
{%- for item in s.items %}<li class="flex">{{ testimonial(item, { variant: "compact" }) }}</li>{% endfor %}
</ul>
</div>
{%- else %}
<ul class="grid gap-6 md:gap-8 md:grid-cols-3{{ ' reveal-items' if ctx.reveal }}">
{%- for f in s.items %}<li class="{{ item(loop.index0, 3, ctx, 'scale') }}">{{ testimonial(f, { variant: "compact" }) }}</li>{% endfor %}
</ul>
{%- endif %}
{% endcall %}
{% endmacro %}
