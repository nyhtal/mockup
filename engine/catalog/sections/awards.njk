{#
  name: awards
  purpose: Awards and certifications as a row of badges with names (R-SCH-08: never fabricated as schema; visible text only).
  anatomy: shell > ul.flex > li(icon disc + name + year)
  variants: none
  states: none
  spacing: gap-8 centred
  motion: reveals
  keyboard: none
  a11y: text names; icons aria-hidden
  i18n: none
  content limits: 3–8 items; name ≤ 40 chars
  data: s = { title, items: [{ name, year, icon }] }
#}
{% from "sections/_shell.njk" import shell, stagger with context %}
{% from "primitives/icon.njk" import icon with context %}
{% macro render(s, ctx) %}
{% call shell("awards", s, ctx, { center: true, itemsReveal: ctx.reveal }) %}
<ul class="flex flex-wrap justify-center gap-8">
{%- for item in s.items %}
<li class="flex w-36 flex-col items-center text-center{{ stagger(loop.index0) if ctx.reveal }}">
<span class="inline-flex size-14 items-center justify-center rounded-full bg-brand-100 text-brand-800">{{ icon(item.icon or "award", { size: "size-6" }) }}</span>
<p class="mt-3 text-sm font-medium">{{ item.name }}</p>
{%- if item.year %}<p class="text-xs text-ink-muted">{{ item.year }}</p>{% endif %}
</li>
{%- endfor %}
</ul>
{% endcall %}
{% endmacro %}
