{#
  name: filter-bar (section)
  purpose: Filters above an index grid.
  anatomy: section(no title) > container > filter-bar component
  data: s = { action, filters, resetHref }
#}
{% from "components/filter-bar.njk" import filterBar with context %}
{% macro render(s, ctx) %}
<section class="py-6 {{ s.surface or 'bg-surface' }}" aria-label="{{ s.label or ('ui.filters' | t) }}" data-component="filter-bar"{% if s.anchor %} id="{{ s.anchor }}"{% endif %}>
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">{{ filterBar(s) }}</div>
</section>
{% endmacro %}
