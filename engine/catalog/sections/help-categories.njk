{#
  name: help-categories
  purpose: Help centre landing: categories with article links.
  anatomy: shell > ul.grid > li(icon + h3 + ul links)
  data: s = { title, lede, items: [{ icon, title, links: [{ label, href }] }] }
#}
{% from "sections/_shell.njk" import shell, stagger with context %}
{% from "primitives/icon.njk" import icon with context %}
{% macro render(s, ctx) %}
{% call shell("help-categories", s, ctx, { itemsReveal: ctx.reveal }) %}
<ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
{%- for item in s.items %}
<li class="rounded-lg border border-line bg-surface-raised p-6{{ stagger(loop.index0) if ctx.reveal }}">
<span class="inline-flex size-10 items-center justify-center rounded-md bg-brand-100 text-brand-800">{{ icon(item.icon or "file-text") }}</span>
<h3 class="mt-4 text-lg font-semibold">{{ item.title }}</h3>
<ul class="mt-3 space-y-2 text-sm">{% for l in item.links %}<li><a href="{{ l.href }}" class="text-ink-muted hover:text-ink hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ l.label }}</a></li>{% endfor %}</ul>
</li>
{%- endfor %}
</ul>
{% endcall %}
{% endmacro %}
