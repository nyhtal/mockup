{#
  name: benefits-grid
  purpose: Careers benefits, 4–8 items (R-SEC-03).
  anatomy: shell > ul.grid > li(icon + h3 + p)
  variants: none
  states: none
  spacing: gap-6 md:gap-8; 4 columns at lg
  motion: items arrive by column (four columns: slide-in / rise / framed settle / slide-from-end, R-MOT-16); icons pop (expressive)
  keyboard: none
  a11y: list
  i18n: none
  content limits: title ≤ 4 words; text ≤ 20 words
  data: s = { eyebrow, title, lede, items: [{ icon, title, text }] }
#}
{% from "sections/_shell.njk" import shell, stagger, item, pop with context %}
{% from "primitives/icon.njk" import icon with context %}
{% macro render(s, ctx) %}
{% call shell("benefits-grid", s, ctx, { itemsReveal: ctx.reveal }) %}
<ul class="grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-4{{ ' reveal-items' if ctx.reveal }}">
{%- for f in s.items %}
<li class="flex gap-4{{ item(loop.index0, 4, ctx) }}">
<span class="mt-1 inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-brand-100 text-brand-800{{ pop(ctx, (loop.index0 % 4) * 90) }}">{{ icon(f.icon or "check", { size: "size-4" }) }}</span>
<div><h3 class="font-semibold">{{ f.title }}</h3><p class="mt-1 text-sm leading-relaxed text-ink-muted">{{ f.text }}</p></div>
</li>
{%- endfor %}
</ul>
{% endcall %}
{% endmacro %}
