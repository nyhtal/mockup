{#
  name: search-box (section)
  purpose: Large search form on the search and help pages.
  anatomy: shell > search-box(hero)
  data: s = { title, lede }
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "components/search-box.njk" import searchBox with context %}
{% macro render(s, ctx) %}
{% call shell("search-box", s, ctx, { noReveal: true }) %}<div class="mx-auto max-w-2xl">{{ searchBox(ctx.locale, { variant: "hero", id: "q-page" }) }}</div>{% endcall %}
{% endmacro %}
