{#
  name: apply-form
  purpose: Job application with a file field (R-FORM-11); with steps, a short wizard: contact details first, the file last (R-FORM-07).
  anatomy: shell > form card > (progress) + form
  data: s = { title, lede, form: {…}, step }; form.steps = [{ label, title, description, fields }] shows the progress bar and step s.step (1 on the job page; the engine builds the later steps' pages)
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "sections/_form.njk" import formBody with context %}
{% from "components/progress.njk" import progress with context %}
{% macro render(s, ctx) %}
{%- set step = s.step or 1 -%}
{% call shell("apply-form", s, ctx) %}
<div class="mx-auto max-w-xl rounded-xl border border-line bg-surface-raised p-6 shadow-sm md:p-8">{% if s.form.steps %}<div class="mb-8">{{ progress(step, s.form.steps | length, s.form.steps[step - 1].label) }}</div>{% endif %}{{ formBody(s.form, ctx, step) }}</div>
{% endcall %}
{% endmacro %}
