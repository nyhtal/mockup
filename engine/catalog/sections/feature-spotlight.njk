{#
  name: feature-spotlight
  purpose: One large picture beside 2–4 compact points: a substantial image instead of a row of thumbnails (R-SEC-03, R-SEC-04).
  anatomy: shell > div.grid(lg:grid-cols-12) > figure[7 cols](frame > picture + figcaption?) + ul[5 cols, hairlines between](li: eyebrow? + h3 + p)
  variants: none
  states: none
  spacing: grid gap-12, items centred; points py-6 with divide-y, the first without top padding, the last without bottom
  motion: the figure slides in from the inline start and its picture settles from 115 % inside the frame; the points rise in sequence (R-MOT-16)
  keyboard: none
  a11y: the picture takes its declared alt ("" when it only decorates); the caption, when present, is a figcaption
  i18n: the picture sits at the inline start in every direction
  content limits: 2–4 items; title ≤ 8 words; text ≤ 30 words; caption ≤ 20 words
  data: s = { eyebrow, title, lede, image (or items[0].image): { slug, alt, art, tone }, caption, items: [{ eyebrow, title, text }] }
#}
{% from "sections/_shell.njk" import shell, revealClasses, stagger, zoom with context %}
{% from "primitives/picture.njk" import picture with context %}
{% macro render(s, ctx) %}
{%- set src = s.image or s.items[0].image -%}
{%- set img = { slug: src.slug, ratio: "4:3", alt: src.alt or "", max: 1200, art: src.art, tone: src.tone } -%}
{% call shell("feature-spotlight", s, ctx, { itemsReveal: ctx.reveal, clipX: true }) %}
<div class="grid items-center gap-12 lg:grid-cols-12">
<figure class="lg:col-span-7{{ revealClasses(ctx.reveal, 'start', true) }}">
<div class="overflow-clip rounded-2xl ring-1 ring-line">{{ picture(img, { sizes: "(min-width: 64rem) 55vw, 100vw", class: "aspect-[4/3] w-full object-cover" + zoom(ctx) }) }}</div>
{%- if s.caption %}<figcaption class="mt-3 text-sm text-ink-muted">{{ s.caption }}</figcaption>{% endif %}
</figure>
<ul class="divide-y divide-line lg:col-span-5">
{%- for f in s.items %}
<li class="py-6 first:pt-0 last:pb-0{{ stagger(loop.index0) if ctx.reveal }}">
{%- if f.eyebrow %}<p class="text-sm font-medium uppercase tracking-wide text-ink-brand">{{ f.eyebrow }}</p>{% endif %}
<h3 class="{{ 'mt-2' if f.eyebrow }} text-xl font-semibold tracking-tight">{{ f.title }}</h3>
<p class="mt-2 text-base leading-relaxed text-ink-muted">{{ f.text }}</p>
</li>
{%- endfor %}
</ul>
</div>
{% endcall %}
{% endmacro %}
