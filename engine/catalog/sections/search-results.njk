{#
  name: search-results (section)
  purpose: Static results list on the search page.
  anatomy: shell(center false) > search-results component
  data: s = { query, items: [...], cta }
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "components/search-results.njk" import searchResults with context %}
{% macro render(s, ctx) %}
{% call shell("search-results", s, ctx, { center: false, noReveal: true }) %}<div>{{ searchResults((s.items | searchPage(s.query, s.page, s.perPage)) | merge({ query: s.query, cta: s.cta }), { base: "/" + ctx.locale + "/search/", id: "sf" + ctx.index }) }}</div>{% endcall %}
{% endmacro %}
