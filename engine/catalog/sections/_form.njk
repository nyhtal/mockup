{#
  name: _form (helper, not a section)
  purpose: Shared body for every form section (R-FORM-01, R-FORM-08, R-FORM-09, R-FORM-10, R-FORM-13): GET to a thank-you page, fields stacked, privacy note, honeypot, one submit.
  usage: {{ formBody(s, ctx) }} where s.form = { action, fields: [], submit, privacyHref, consent: field }
#}
{% from "primitives/field.njk" import field %}
{% from "primitives/button.njk" import button %}
{% from "components/error-summary.njk" import errorSummary %}
{% macro formBody(f, ctx) %}
<form method="get" action="{{ f.action }}" class="space-y-6">
{%- if f.errors %}{{ errorSummary(f.errors) }}{% endif %}
{%- for fld in f.fields %}
{%- if fld.pair %}
<div class="grid gap-6 md:grid-cols-2">{% for p in fld.pair %}{{ field(p) }}{% endfor %}</div>
{%- else %}{{ field(fld) }}{% endif %}
{%- endfor %}
{%- if f.consent %}{{ field(f.consent) }}{% endif %}
<div hidden><label for="{{ f.id or 'form' }}-website">Website</label><input type="text" id="{{ f.id or 'form' }}-website" name="website" tabindex="-1" autocomplete="off"></div>
{%- if f.privacyHref %}<p class="text-sm text-ink-muted">{{ "ui.privacyNote" | t }} <a href="{{ f.privacyHref }}" class="underline underline-offset-4 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ "ui.privacyPolicy" | t }}</a></p>{% endif %}
<div>{{ button(f.submit, { type: "submit" }) }}</div>
</form>
{% endmacro %}
