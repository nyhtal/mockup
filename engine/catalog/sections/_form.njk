{#
  name: _form (helper, not a section)
  purpose: Shared body for every form section (R-FORM-01, R-FORM-07, R-FORM-08, R-FORM-09, R-FORM-10, R-FORM-13): GET to a thank-you page, fields stacked, privacy note, honeypot, one submit.
  usage: {{ formBody(s.form, ctx, step) }} where s.form = { action, fields: [], submit, privacyHref, consent: field }; a stepped form has steps: [{ label, title, description, fields }] and stepPath in place of fields: step n (from 1) shows its own fields, sends to `${stepPath}${n + 1}/` with a Continue button, and the last step sends to action with the form's submit label. The engine builds the pages for steps 2 onwards (R-FORM-07).
#}
{% from "primitives/field.njk" import field with context %}
{% from "primitives/button.njk" import button with context %}
{% from "components/error-summary.njk" import errorSummary with context %}
{% macro formBody(f, ctx, step=1) %}
{%- set last = not f.steps or step >= (f.steps | length) -%}
{%- set fields = f.steps[step - 1].fields if f.steps else f.fields -%}
<form method="get" action="{{ f.action if last else f.stepPath + (step + 1) + '/' }}" class="space-y-6">
{%- if f.errors %}{{ errorSummary(f.errors) }}{% endif %}
{%- for fld in fields %}
{%- if fld.pair %}
<div class="grid gap-6 md:grid-cols-2">{% for p in fld.pair %}{{ field(p) }}{% endfor %}</div>
{%- else %}{{ field(fld) }}{% endif %}
{%- endfor %}
{%- if f.consent and last %}{{ field(f.consent) }}{% endif %}
<div hidden><label for="{{ f.id or 'form' }}-website">{{ "ui.website" | t }}</label><input type="text" id="{{ f.id or 'form' }}-website" name="website" tabindex="-1" autocomplete="off"></div>
{%- if f.privacyHref %}<p class="text-sm text-ink-muted">{{ "ui.privacyNote" | t }} <a href="{{ f.privacyHref }}" class="underline underline-offset-4 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ "ui.privacyPolicy" | t }}</a></p>{% endif %}
<div>{{ button(f.submit if last else ("ui.continue" | t), { type: "submit" }) }}</div>
</form>
{% endmacro %}
