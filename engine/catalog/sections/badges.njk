{#
  name: badges
  purpose: Trust and compliance marks on the trust page (ISO, SOC 2) as named tiles.
  anatomy: shell > ul.grid > li(icon + name + text)
  variants: none
  states: none
  spacing: gap-6 md:gap-8; 3 columns
  motion: reveals
  keyboard: none
  a11y: text; icons aria-hidden
  i18n: none
  content limits: 3–6 items
  data: s = { title, lede, items: [{ name, text, icon }] }
#}
{% from "sections/_shell.njk" import shell, stagger, item, pop with context %}
{% from "primitives/icon.njk" import icon with context %}
{% macro render(s, ctx) %}
{% call shell("badges", s, ctx, { itemsReveal: ctx.reveal }) %}
<ul class="grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3{{ ' reveal-items' if ctx.reveal }}">
{%- for f in s.items %}
<li class="flex items-start gap-4 rounded-lg border border-line bg-surface-raised p-6{{ item(loop.index0, 3, ctx) }}">
<span class="inline-flex size-12 shrink-0 items-center justify-center rounded-md bg-brand-100 text-brand-800{{ pop(ctx, (loop.index0 % 3) * 90) }}">{{ icon(f.icon or "shield-check", { size: "size-6" }) }}</span>
<div class="min-w-0"><h3 class="font-semibold">{{ f.name }}</h3><p class="mt-1 text-sm leading-relaxed text-ink-muted">{{ f.text }}</p></div>
</li>
{%- endfor %}
</ul>
{% endcall %}
{% endmacro %}
