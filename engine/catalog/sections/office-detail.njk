{#
  name: office-detail
  purpose: One office: address, hours, phone, email, and a map facade (R-I18N-14).
  anatomy: shell(center false) > grid > address block + map-facade
  data: s = { title, address, phone, email, hours: [["Weekdays", "08:00–18:00"]], map: { slug, address } }
#}
{% from "sections/_shell.njk" import shell %}
{% from "components/map-facade.njk" import mapFacade %}
{% from "components/data-table.njk" import dataTable %}
{% macro render(s, ctx) %}
{% call shell("office-detail", s, ctx, { center: false }) %}
<div class="grid gap-12 lg:grid-cols-2">
<div>
<address class="space-y-2 text-base not-italic leading-relaxed">
<p>{{ s.address }}</p>
{%- if s.phone %}<p><a href="tel:{{ s.phone | replace(' ', '') }}" class="underline underline-offset-4 hover:text-ink-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ s.phone }}</a></p>{% endif %}
{%- if s.email %}<p><a href="mailto:{{ s.email }}" class="underline underline-offset-4 hover:text-ink-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ s.email }}</a></p>{% endif %}
</address>
{%- if s.hours %}<div class="mt-8">{{ dataTable({ caption: s.hoursCaption or "Opening hours", columns: [s.hoursColumns[0] if s.hoursColumns else "Day", s.hoursColumns[1] if s.hoursColumns else "Hours"], rows: s.hours }, { rowHeaders: true }) }}</div>{% endif %}
</div>
{{ mapFacade(s.map) }}
</div>
{% endcall %}
{% endmacro %}
