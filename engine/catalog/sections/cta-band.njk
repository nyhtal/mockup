{#
  name: cta-band
  purpose: The page's one call-to-action band, near the end (R-SEC-05, R-COL-09).
  anatomy: section[data-component=cta-band] > container > h2 + p + buttons
  variants: none
  states: none
  spacing: py-16 md:py-24; centred; an inset rounded-2xl panel carries the gradient and a radial highlight in the top start corner (R-COL-09)
  motion: the panel settles from 96 % (a framed object, DESIGN §3); in expressive its highlight drifts 24 px across as the panel passes (R-MOT-15)
  keyboard: buttons
  a11y: inverse text on the gradient meets contrast (brand-700 base)
  i18n: none
  content limits: title ≤ 60 chars; text ≤ 20 words; one primary (+ one secondary)
  data: s = { title, text, primary: {label, href}, secondary: {label, href} }
#}
{% from "sections/_shell.njk" import revealClasses, depth with context %}
{% from "primitives/button.njk" import button with context %}
{% macro render(s, ctx) %}
{%- set pad = "py-12 md:py-16" if ctx.density == "compact" else "py-16 md:py-24" -%}
<section class="{{ pad }} {{ s.surface or ctx.surface or 'bg-surface' }}{{ revealClasses(ctx.reveal, 'scale') }}" data-component="cta-band">
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="relative isolate overflow-clip rounded-2xl bg-linear-to-br from-brand-700 via-brand-600 to-accent-600 px-6 py-12 text-center text-ink-inverse shadow-xl shadow-brand-900/20 sm:px-12 md:py-16 before:absolute before:-top-32 before:-start-32 before:-z-10 before:size-96 before:rounded-full before:bg-ink-inverse/15 before:blur-3xl{{ depth('drift', 'view()', 'cover_0%_cover_100%', 'before:') if ctx.flair and ctx.flair.drift }}">
<h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-balance">{{ s.title }}</h2>
{%- if s.text %}<p class="mx-auto mt-4 max-w-2xl text-lg text-ink-inverse/85">{{ s.text }}</p>{% endif %}
<div class="mt-8 flex flex-wrap justify-center gap-3">
{{ button(s.primary.label, { href: s.primary.href, variant: "inverse" }) }}
{%- if s.secondary %}{{ button(s.secondary.label, { href: s.secondary.href, variant: "inverse-outline" }) }}{% endif %}
</div>
</div>
</div>
</section>
{% endmacro %}
