{#
  name: hero
  purpose: The first section of home and landing pages: h1, lede, two buttons, LCP media (R-SEC-07, R-MOT-11, R-PERF-05).
  anatomy: section[data-component=hero data-variant] > container > (grid) text(h1 + lede + buttons) + media | form | stats
  variants: centered | split (text + picture) | video (text + video facade) | form (text + short form) | stats (text + 3 stats)
  states: none
  spacing: py-16 md:py-24; grid gap-12
  motion: none on load; nothing in the hero reveals
  keyboard: buttons, then the form or facade
  a11y: the h1 lives here; the picture is the LCP image with fetchpriority=high
  i18n: buttons ≤ 25 chars
  content limits: h1 ≤ 60 chars, lede ≤ 35 words, exactly one primary and one secondary button
  data: s = { variant, eyebrow, title, lede, primary: {label, href}, secondary: {label, href}, image: {slug, ratio, alt}, video, form: [fields], stats: [{value,label}] }
#}
{% from "primitives/button.njk" import button %}
{% from "primitives/picture.njk" import picture %}
{% from "primitives/field.njk" import field %}
{% from "components/video-facade.njk" import videoFacade %}
{% from "components/stat.njk" import stat %}
{% macro render(s, ctx) %}
{%- set variant = s.variant or "centered" -%}
{%- set pad = "py-12 md:py-20" if ctx.density == "compact" else "py-16 md:py-28" -%}
<section class="{{ pad }} {{ s.surface or 'bg-surface' }}" data-component="hero" data-variant="{{ variant }}">
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="{{ 'mx-auto max-w-3xl text-center' if variant == 'centered' else 'grid items-center gap-12 lg:grid-cols-2' }}">
<div>
{%- if s.eyebrow %}<p class="text-sm font-medium uppercase tracking-wide text-ink-brand">{{ s.eyebrow }}</p>{% endif %}
{%- set h = "h2" if ctx.demote else "h1" -%}
<{{ h }} class="{{ 'mt-3' if s.eyebrow }} text-4xl md:text-5xl font-bold tracking-tight text-balance">{{ s.title }}</{{ h }}>
<p class="mt-6 text-lg md:text-xl text-ink-muted {{ 'mx-auto max-w-2xl' if variant == 'centered' else 'max-w-2xl' }}">{{ s.lede }}</p>
<div class="mt-8 flex flex-wrap gap-3 {{ 'justify-center' if variant == 'centered' }}">
{%- if s.primary %}{{ button(s.primary.label, { href: s.primary.href }) }}{% endif %}
{%- if s.secondary %}{{ button(s.secondary.label, { href: s.secondary.href, variant: "secondary" }) }}{% endif %}
</div>
{%- if variant == "stats" and s.stats %}
<div class="mt-12 grid grid-cols-3 gap-6">{% for st in s.stats %}{{ stat(st) }}{% endfor %}</div>
{%- endif %}
</div>
{%- if variant == "split" and s.image %}
<div class="overflow-hidden rounded-xl">{{ picture(s.image, { priority: true, sizes: "(min-width: 64rem) 50vw, 100vw", class: "aspect-[4/3] w-full object-cover" }) }}</div>
{%- elif variant == "video" and s.video %}
{{ videoFacade(s.video) }}
{%- elif variant == "form" and s.form %}
<form method="get" action="{{ s.form.action }}" class="rounded-xl border border-line bg-surface-raised p-6 shadow-sm">
<h2 class="text-xl font-semibold">{{ s.form.title }}</h2>
<div class="mt-6 space-y-6">{% for f in s.form.fields %}{{ field(f) }}{% endfor %}</div>
<div class="mt-6">{{ button(s.form.submit, { type: "submit", class: "w-full" }) }}</div>
</form>
{%- elif variant == "centered" and s.image %}
{%- endif %}
</div>
{%- if variant == "centered" and s.image %}
<div class="mt-12 overflow-hidden rounded-xl">{{ picture(s.image, { priority: true, sizes: "(min-width: 80rem) 80rem, 100vw", class: "aspect-video w-full object-cover" }) }}</div>
{%- endif %}
</div>
</section>
{% endmacro %}
