{#
  name: hero
  purpose: The first section of home and landing pages: h1, lede, two buttons, LCP media (R-SEC-07, R-MOT-11, R-PERF-05).
  anatomy: section[data-component=hero data-variant] > container > (grid lg:grid-cols-12) text(h1 + lede + buttons + proof strip)[7 columns at lg, 6 at xl, so a German compound fits the measure] + media[5, then 6]; the h1 is one size smaller in German at xl ("Steuerungssoftware," needs about 620 px at text-6xl, more than the column) (+ highlight card over its top-end corner) | form | stats
  variants: centered | split (text + picture) | video (text + native video when s.video.slug is set, else a third-party facade) | form (text + short form) | stats (text + 3 stats) | backdrop (the art fills the section behind the eased scrim, text over the quiet start side in inverse ink; s.inset puts it in a rounded frame inside the container, text at its bottom-start) | panel (the art fills the section, the text sits on an opaque raised panel) | editorial (a large light-weight headline, lede and actions on one row, a 21:9 panorama under them)
  states: none
  spacing: py-16 md:py-28 (backdrop inset: pt-4 md:pt-6 pb-16 md:pb-28, the frame px-6 py-12 → md:px-14 md:py-16); backdrop and panel at least min-h-144 (36 rem) at lg, inset min-h-160; grid gap-12; a brand glow behind the text and an accent glow behind the media (DESIGN §4, R-COL-09); proof strip mt-12, three columns with hairlines, value above label so long labels wrap inside their column in every locale
  motion: none on load; nothing in the hero reveals or counts (R-MOT-11); in expressive the split picture and the glows carry depth that is at identity at rest and moves only with the scroll (R-MOT-15)
  keyboard: buttons, then the form or facade
  a11y: the h1 lives here; the picture is the LCP image with fetchpriority=high; the proof strip is a list; the highlight card is plain text
  i18n: buttons ≤ 25 chars; the highlight card mirrors to the top-start corner in RTL through logical end-*
  content limits: h1 ≤ 60 chars, lede ≤ 35 words, exactly one primary and one secondary button; proof ≤ 3 items of value ≤ 8 chars and label ≤ 4 words; highlight value ≤ 8 chars, label ≤ 4 words
  data: s = { variant, inset, eyebrow, title, lede, primary: {label, href}, secondary: {label, href}, image: {slug, ratio, alt, art, tone} (backdrop and panel force tone dark and alt "": the art is decoration behind the words), video: {slug, title, duration} | facade data, form: [fields], stats: [{value,label}], proof: [{value,label}], highlight: {icon, value, label} }
#}
{% from "primitives/button.njk" import button with context %}
{% from "primitives/picture.njk" import picture with context %}
{% from "primitives/field.njk" import field with context %}
{% from "primitives/icon.njk" import icon with context %}
{% from "components/video-facade.njk" import videoFacade with context %}
{% from "components/video.njk" import video with context %}
{% from "components/stat.njk" import stat with context %}
{% from "sections/_shell.njk" import depth with context %}
{#- The art layer of the image-led variants (DESIGN §5): a dark-tone library piece filling its box, mirrored in RTL on the wrapper (abstract art may mirror; the picture's own scale carries the depth). -#}
{% macro artLayer(s, ctx, defaultArt) %}
{%- set hd = ctx.flair and ctx.flair.parallaxHero -%}
{%- set img = { slug: s.image.slug, ratio: s.image.ratio or "16:9", alt: "", max: 1600, art: s.image.art or defaultArt, tone: "dark" } -%}
<div aria-hidden="true" class="absolute inset-0 -z-10 overflow-clip rtl:-scale-x-100">{{ picture(img, { priority: true, sizes: "(min-width: 48rem) 100vw, 200vw", class: "absolute inset-0 size-full object-cover" + (" md:motion-safe:sda:scale-115 md:motion-safe:sda:translate-y-4" + depth('parallax-md', 'scroll(root)', '0_80vh') if hd) }) }}</div>
{% endmacro %}
{#- Eyebrow, h1, lede, buttons and proof in inverse ink, for text that sits on the dark art behind the scrim. -#}
{% macro inverseText(s, ctx) %}
{%- if s.eyebrow %}<p class="flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-ink-inverse/85 before:h-0.5 before:w-6 before:rounded-full before:bg-accent-300">{{ s.eyebrow }}</p>{% endif %}
{%- set h = "h2" if ctx.demote else "h1" -%}
<{{ h }} class="{{ 'mt-3' if s.eyebrow }} text-4xl md:text-5xl xl:text-6xl xl:[&:lang(de)]:text-5xl font-semibold tracking-tight text-balance">{{ s.title | wbr | safe }}</{{ h }}>
<p class="mt-6 max-w-2xl text-lg md:text-xl text-ink-inverse/85">{{ s.lede }}</p>
<div class="mt-8 flex flex-wrap gap-3">
{%- if s.primary %}{{ button(s.primary.label, { href: s.primary.href, variant: "inverse" }) }}{% endif %}
{%- if s.secondary %}{{ button(s.secondary.label, { href: s.secondary.href, variant: "inverse-outline" }) }}{% endif %}
</div>
{%- if s.proof and s.proof.length %}
<ul class="mt-12 grid max-w-md grid-cols-3 gap-4">
{%- for p in s.proof %}<li class="border-s border-ink-inverse/25 ps-4 first:border-s-0 first:ps-0"><span class="block whitespace-nowrap text-xl font-semibold tabular-nums md:text-2xl">{{ p.value }}</span><span class="mt-1 block text-sm text-ink-inverse/80">{{ p.label }}</span></li>{% endfor %}
</ul>
{%- endif %}
{% endmacro %}
{#- backdrop: the art fills the section (or, inset, a rounded frame in the container); the text sits over the quiet start side behind the eased scrim (R-COL-09). -#}
{% macro backdrop(s, ctx) %}
{%- set compact = ctx.density == "compact" -%}
{%- if s.inset %}
<section class="{{ 'pt-4 md:pt-6 pb-12 md:pb-20' if compact else 'pt-4 md:pt-6 pb-16 md:pb-28' }} {{ s.surface or 'bg-surface' }}" data-component="hero" data-variant="backdrop"{% if s.anchor %} id="{{ s.anchor }}"{% endif %}>
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="relative isolate overflow-hidden rounded-3xl bg-brand-950 text-ink-inverse">
{{ artLayer(s, ctx, "contours-quiet") }}
<div aria-hidden="true" class="absolute inset-0 -z-10 bg-art-scrim rtl:-scale-x-100"></div>
<div class="flex items-end px-6 py-12 sm:px-10 md:px-14 md:py-16 lg:min-h-160"><div class="max-w-2xl">{{ inverseText(s, ctx) }}</div></div>
</div>
</div>
</section>
{%- else %}
<section class="relative isolate overflow-hidden {{ 'py-12 md:py-20' if compact else 'py-16 md:py-28' }} bg-brand-950 text-ink-inverse" data-component="hero" data-variant="backdrop"{% if s.anchor %} id="{{ s.anchor }}"{% endif %}>
{{ artLayer(s, ctx, "contours-quiet") }}
<div aria-hidden="true" class="absolute inset-0 -z-10 bg-art-scrim rtl:-scale-x-100"></div>
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex items-center lg:min-h-144"><div class="max-w-2xl lg:w-7/12">{{ inverseText(s, ctx) }}</div></div>
</div>
</section>
{%- endif %}
{% endmacro %}
{#- panel: the art fills the section; the text sits on an opaque raised panel, so it never touches the picture in either theme. -#}
{% macro panel(s, ctx) %}
<section class="relative isolate overflow-hidden {{ 'py-12 md:py-20' if ctx.density == 'compact' else 'py-16 md:py-28' }} bg-brand-950" data-component="hero" data-variant="panel"{% if s.anchor %} id="{{ s.anchor }}"{% endif %}>
{{ artLayer(s, ctx, "ribbon-quiet") }}
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="grid items-center lg:min-h-144 lg:grid-cols-12">
<div class="rounded-2xl bg-surface-raised p-8 text-ink shadow-xl shadow-ink/20 ring-1 ring-line md:p-12 lg:col-span-7 xl:col-span-6">
{%- if s.eyebrow %}<p class="flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-ink-brand before:h-0.5 before:w-6 before:rounded-full before:bg-accent-600">{{ s.eyebrow }}</p>{% endif %}
{%- set h = "h2" if ctx.demote else "h1" -%}
<{{ h }} class="{{ 'mt-3' if s.eyebrow }} text-4xl md:text-5xl xl:[&:lang(de)]:text-4xl font-semibold tracking-tight text-balance">{{ s.title | wbr | safe }}</{{ h }}>
<p class="mt-6 text-lg text-ink-muted">{{ s.lede }}</p>
<div class="mt-8 flex flex-wrap gap-3">
{%- if s.primary %}{{ button(s.primary.label, { href: s.primary.href }) }}{% endif %}
{%- if s.secondary %}{{ button(s.secondary.label, { href: s.secondary.href, variant: "secondary" }) }}{% endif %}
</div>
</div>
</div>
</div>
</section>
{% endmacro %}
{#- editorial: no glow and no frame; a large light-weight headline, the lede and the actions on one row under it, then a full-container panorama. -#}
{% macro editorial(s, ctx) %}
{%- set img = { slug: s.image.slug, ratio: "21:9", alt: s.image.alt or "", max: 1600, art: s.image.art, tone: s.image.tone } -%}
<section class="{{ 'py-12 md:py-20' if ctx.density == 'compact' else 'py-16 md:py-28' }} {{ s.surface or 'bg-surface' }}" data-component="hero" data-variant="editorial"{% if s.anchor %} id="{{ s.anchor }}"{% endif %}>
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
{%- if s.eyebrow %}<p class="flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-ink-brand before:h-0.5 before:w-6 before:rounded-full before:bg-accent-600">{{ s.eyebrow }}</p>{% endif %}
{%- set h = "h2" if ctx.demote else "h1" -%}
<{{ h }} class="{{ 'mt-4' if s.eyebrow }} max-w-5xl text-5xl md:text-6xl xl:text-7xl xl:[&:lang(de)]:text-6xl font-medium leading-tight tracking-tighter text-balance">{{ s.title | wbr | safe }}</{{ h }}>
<div class="mt-10 grid items-end gap-8 lg:grid-cols-12">
<p class="text-lg md:text-xl text-ink-muted lg:col-span-6">{{ s.lede }}</p>
<div class="lg:col-span-5 lg:col-start-8">
<div class="flex flex-wrap gap-3">
{%- if s.primary %}{{ button(s.primary.label, { href: s.primary.href }) }}{% endif %}
{%- if s.secondary %}{{ button(s.secondary.label, { href: s.secondary.href, variant: "secondary" }) }}{% endif %}
</div>
{%- if s.proof and s.proof.length %}
<ul class="mt-8 grid max-w-md grid-cols-3 gap-4">
{%- for p in s.proof %}<li class="border-s border-line ps-4 first:border-s-0 first:ps-0"><span class="block whitespace-nowrap text-xl font-semibold tabular-nums text-ink md:text-2xl">{{ p.value }}</span><span class="mt-1 block text-sm text-ink-muted">{{ p.label }}</span></li>{% endfor %}
</ul>
{%- endif %}
</div>
</div>
{%- if s.image %}
<div class="mt-12 overflow-clip rounded-2xl ring-1 ring-line md:mt-16">{{ picture(img, { priority: true, sizes: "(min-width: 80rem) 80rem, 100vw", class: "aspect-video w-full object-cover md:aspect-[21/9]" }) }}</div>
{%- endif %}
</div>
</section>
{% endmacro %}
{% macro render(s, ctx) %}
{%- set variant = s.variant or "centered" -%}
{%- if variant == "backdrop" %}{{ backdrop(s, ctx) }}
{%- elif variant == "panel" %}{{ panel(s, ctx) }}
{%- elif variant == "editorial" %}{{ editorial(s, ctx) }}
{%- else %}
{%- set pad = "py-12 md:py-20" if ctx.density == "compact" else "py-16 md:py-28" -%}
{%- set split = variant == "split" or variant == "video" or variant == "form" -%}
<section class="relative isolate overflow-hidden {{ pad }} {{ s.surface or 'bg-surface' }}" data-component="hero"{% if s.anchor %} id="{{ s.anchor }}"{% endif %} data-variant="{{ variant }}">
{#- Depth (R-MOT-15, expressive): the glows sink 16 px over the first 80 vh of scroll; a static half-travel offset keeps them at identity at rest; the layer is taller than the section so no edge shows. -#}
{%- set hd = ctx.flair and ctx.flair.parallaxHero -%}
<div aria-hidden="true" class="pointer-events-none absolute {{ 'inset-x-0 -inset-y-8 md:motion-safe:sda:translate-y-2' + depth('parallax-sm', 'scroll(root)', '0_80vh') if hd else 'inset-0' }} -z-10 bg-hero-backdrop"></div>
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="{{ 'mx-auto max-w-3xl text-center' if variant == 'centered' else 'grid items-center gap-12 lg:grid-cols-12' }}">
<div class="{{ 'lg:col-span-7 xl:col-span-6' if split else ('lg:col-span-12' if variant == 'stats') }}">
{%- if s.eyebrow %}<p class="flex items-center gap-2 {{ 'justify-center' if variant == 'centered' }} text-sm font-medium uppercase tracking-wide text-ink-brand before:h-0.5 before:w-6 before:rounded-full before:bg-accent-600">{{ s.eyebrow }}</p>{% endif %}
{%- set h = "h2" if ctx.demote else "h1" -%}
<{{ h }} class="{{ 'mt-3' if s.eyebrow }} text-4xl md:text-5xl xl:text-6xl xl:[&:lang(de)]:text-5xl font-bold tracking-tight text-balance">{{ s.title | wbr | safe }}</{{ h }}>
<p class="mt-6 text-lg md:text-xl text-ink-muted {{ 'mx-auto max-w-2xl' if variant == 'centered' else 'max-w-2xl' }}">{{ s.lede }}</p>
<div class="mt-8 flex flex-wrap gap-3 {{ 'justify-center' if variant == 'centered' }}">
{%- if s.primary %}{{ button(s.primary.label, { href: s.primary.href }) }}{% endif %}
{%- if s.secondary %}{{ button(s.secondary.label, { href: s.secondary.href, variant: "secondary" }) }}{% endif %}
</div>
{%- if s.proof and s.proof.length %}
<ul class="mt-12 grid max-w-md grid-cols-3 gap-4 {{ 'mx-auto' if variant == 'centered' }}">
{%- for p in s.proof %}<li class="border-s border-line ps-4 first:border-s-0 first:ps-0"><span class="block whitespace-nowrap text-xl font-semibold tabular-nums text-ink md:text-2xl">{{ p.value }}</span><span class="mt-1 block text-sm text-ink-muted">{{ p.label }}</span></li>{% endfor %}
</ul>
{%- endif %}
{%- if variant == "stats" and s.stats %}
<div class="mt-12 grid grid-cols-3 gap-6">{% for st in s.stats %}{{ stat(st) }}{% endfor %}</div>
{%- endif %}
</div>
{%- if split %}
<div class="relative lg:col-span-5 xl:col-span-6">
{%- if variant == "split" and s.image %}
{#- The picture inside its frame sinks 32 px over the first 80 vh (parallax-md with a 16 px static offset so it is at identity at rest), overscanned 15 % so no edge shows. -#}
<div class="overflow-hidden rounded-2xl ring-1 ring-line shadow-xl shadow-ink/10">{{ picture(s.image, { priority: true, sizes: "(min-width: 64rem) 58vw, 100vw", class: "aspect-[4/3] w-full object-cover" + (" md:motion-safe:sda:scale-115 md:motion-safe:sda:translate-y-4" + depth('parallax-md', 'scroll(root)', '0_80vh') if hd) }) }}</div>
{%- elif variant == "video" and s.video %}
{% if s.video.slug %}{{ video(s.video) }}{% else %}{{ videoFacade(s.video) }}{% endif %}
{%- elif variant == "form" and s.form %}
<form method="get" action="{{ s.form.action }}" class="rounded-xl border border-line bg-surface-raised p-6 shadow-sm">
<h2 class="text-xl font-semibold">{{ s.form.title }}</h2>
<div class="mt-6 space-y-6">{% for f in s.form.fields %}{{ field(f) }}{% endfor %}</div>
<div class="mt-6">{{ button(s.form.submit, { type: "submit", class: "w-full" }) }}</div>
</form>
{%- endif %}
{%- if s.highlight and variant != "form" %}
<div class="mt-6 flex items-center gap-4 rounded-lg border border-line bg-surface-raised p-4 shadow-md lg:absolute lg:-top-6 lg:-end-6 lg:mt-0">
<span class="inline-flex size-12 shrink-0 items-center justify-center rounded-md bg-brand-100 text-brand-800">{{ icon(s.highlight.icon or "trending-up", { size: "size-6" }) }}</span>
<span><span class="block text-2xl font-bold tabular-nums text-ink">{{ s.highlight.value }}</span><span class="block text-sm text-ink-muted">{{ s.highlight.label }}</span></span>
</div>
{%- endif %}
</div>
{%- endif %}
</div>
{%- if variant == "centered" and s.image %}
<div class="mt-12 overflow-hidden rounded-2xl ring-1 ring-line shadow-xl shadow-ink/10">{{ picture(s.image, { priority: true, sizes: "(min-width: 80rem) 80rem, 100vw", class: "aspect-video w-full object-cover" }) }}</div>
{%- endif %}
</div>
</section>
{%- endif %}
{% endmacro %}
