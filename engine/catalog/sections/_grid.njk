{#
  name: _grid (helper, not a section)
  purpose: A section whose body is a grid of cards of one variant (R-LAY-03, R-SEC-03). Used by every "*-cards" section.
  usage: {{ cardGrid("case-study-cards", s, ctx, "case-study", 3) }}
#}
{% from "sections/_shell.njk" import shell, stagger %}
{% from "components/card.njk" import card %}
{% from "components/empty-state.njk" import emptyState %}
{% macro cardGrid(name, s, ctx, variant, cols) %}
{%- set colClass = "md:grid-cols-2" if cols == 2 else ("md:grid-cols-2 lg:grid-cols-4" if cols == 4 else "md:grid-cols-2 lg:grid-cols-3") -%}
{% call shell(name, s, ctx) %}
{%- if s.items and s.items.length %}
<ul class="grid gap-6 md:gap-8 {{ colClass }}">
{%- for item in s.items %}
{%- set merged = { variant: variant } -%}
{{ card(item | merge({ variant: item.variant or variant }), { density: ctx.density }) }}
{%- endfor %}
</ul>
{%- else %}
{{ emptyState(s.empty or { icon: "info", title: "Nothing here yet", text: "Check back soon." }) }}
{%- endif %}
{% endcall %}
{% endmacro %}
