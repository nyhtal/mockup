{#
  name: faq-groups
  purpose: The FAQ page body: several titled groups of questions (R-PAGE inventory: faq).
  anatomy: shell > div.space-y > div(h3 group title + accordion)
  variants: none
  states: per accordion
  spacing: groups space-y-16; max-w-3xl
  motion: reveals
  keyboard: summaries
  a11y: group titles h3, questions h4
  i18n: none
  content limits: 2–6 groups
  data: s = { title, lede, groups: [{ title, items }] }
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "components/accordion.njk" import accordion with context %}
{% macro render(s, ctx) %}
{% call shell("faq-groups", s, ctx) %}
<div class="mx-auto max-w-3xl space-y-16">
{%- if s.groups.length > 1 %}
<nav aria-label="{{ 'ui.onThisPage' | t }}"><ul class="flex flex-wrap gap-2">{% for g in s.groups %}<li><a href="#faq-{{ ctx.index }}-{{ loop.index }}" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line-strong px-4 text-sm font-medium text-ink hover:border-brand-300 hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ g.title }}<svg aria-hidden="true" class="size-4 shrink-0"><use href="#i-arrow-down"></use></svg></a></li>{% endfor %}</ul></nav>
{%- endif %}
{%- for g in s.groups %}
<div>
<h3 id="faq-{{ ctx.index }}-{{ loop.index }}" class="text-xl md:text-2xl font-semibold">{{ g.title }}</h3>
<div class="mt-6">{{ accordion(g.items, { variant: "faq", group: "faq-" + loop.index, level: 4 }) }}</div>
</div>
{%- endfor %}
</div>
{% endcall %}
{% endmacro %}
