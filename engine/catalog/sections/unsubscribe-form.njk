{#
  name: unsubscribe-form
  purpose: One-field unsubscribe (email) with a plain confirmation.
  anatomy: shell > form card
  data: s = { title, lede, form: {…} }
#}
{% from "sections/_shell.njk" import shell %}
{% from "sections/_form.njk" import formBody %}
{% macro render(s, ctx) %}
{% call shell("unsubscribe-form", s, ctx) %}
<div class="mx-auto max-w-xl rounded-xl border border-line bg-surface-raised p-6 shadow-sm md:p-8">{{ formBody(s.form, ctx) }}</div>
{% endcall %}
{% endmacro %}
