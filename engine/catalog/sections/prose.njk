{#
  name: prose (section)
  purpose: Article body with optional table of contents beside it (posts, legal pages, docs).
  anatomy: shell(center false, no title) > grid > (toc) + prose component
  data: s = { html, toc: [{ id, text, level }], lang }
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "components/prose.njk" import prose with context %}
{% from "components/toc.njk" import toc with context %}
{% macro render(s, ctx) %}
{% call shell("prose", s, ctx, { center: false, noReveal: true }) %}
<div class="{{ 'grid gap-12 lg:grid-cols-4' if s.toc }}">
{%- if s.toc %}<div class="order-2 lg:order-1">{{ toc(s.toc) }}</div>{% endif %}
<div class="{{ 'order-1 lg:order-2 lg:col-span-3' if s.toc }}">{{ prose(s.html, { class: "hyphens-auto" if ctx.locale == "de" }) }}</div>
</div>
{% endcall %}
{% endmacro %}
