{#
  name: download-detail
  purpose: A whitepaper or report: cover, summary, contents list, and the download button (or the gated form below).
  anatomy: shell(center false) > grid > picture(cover) + div(badge + prose + ul + button)
  data: s = { title, slug, gated, fileType, pages, summary (html), contents: [], cover: {slug, ratio, alt}, cta: { label, href } }
  links: an ungated file downloads directly (download, its MIME type); a gated one offers a sample page beside the form; the files are English, so other locales mark them hreflang="en" (to-do 5)
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "primitives/picture.njk" import picture with context %}
{% from "primitives/badge.njk" import badge with context %}
{% from "primitives/button.njk" import button with context %}
{% from "components/prose.njk" import prose with context %}
{% macro render(s, ctx) %}
{% call shell("download-detail", s, ctx, { center: false, noReveal: true }) %}
<div class="grid gap-12 lg:grid-cols-3">
<div class="overflow-hidden rounded-xl">{{ picture(s.cover, { sizes: "(min-width: 64rem) 33vw, 100vw", class: "aspect-[3/4] w-full object-cover" }) }}</div>
<div class="lg:col-span-2">
<p class="flex items-center gap-2">{{ badge(s.fileType or "PDF", { tone: "brand" }) }}{% if s.pages %}<span class="text-sm text-ink-muted">{{ s.pages }}</span>{% endif %}</p>
<div class="mt-4">{{ prose(s.summary, { class: "hyphens-auto" if ctx.locale == "de", loose: ctx.locale == "ar" }) }}</div>
{%- set ch = "h3" if s.title else "h2" -%}
{%- if s.contents %}<{{ ch }} class="mt-8 text-lg font-semibold">{{ s.contentsTitle or ("ui.whatIsInside" | t) }}</{{ ch }}><ul class="mt-3 list-inside list-disc space-y-1 text-base text-ink-muted">{% for c in s.contents %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
{%- set ft = (s.fileType or "PDF") | lower -%}
{%- set mime = { pdf: "application/pdf", csv: "text/csv" }[ft] -%}
{%- if s.cta %}<div class="mt-8">{{ button(s.cta.label, { href: s.cta.href, icon: "download" }) }}</div>
{%- elif s.slug and s.gated == "true" and ft == "pdf" %}<p class="mt-8"><a href="/assets/files/{{ s.slug }}.pdf" download type="application/pdf"{% if ctx.locale != "en" %} hreflang="en"{% endif %} class="inline-block py-1 underline underline-offset-4 hover:text-ink-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{{ "ui.downloadSample" | t }}</a></p>
{%- elif s.slug and mime %}{% set fa = { download: "", type: mime, hreflang: "en" } if ctx.locale != "en" else { download: "", type: mime } %}<div class="mt-8">{{ button("ui.downloadFile" | t | replace("{type}", s.fileType), { href: "/assets/files/" + s.slug + "." + ft, icon: "download", attrs: fa }) }}</div>{% endif %}
</div>
</div>
{% endcall %}
{% endmacro %}
