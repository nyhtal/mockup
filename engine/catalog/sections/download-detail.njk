{#
  name: download-detail
  purpose: A whitepaper or report: cover, summary, contents list, and the download button (or the gated form below).
  anatomy: shell(center false) > grid > picture(cover) + div(badge + prose + ul + button)
  data: s = { title, type, pages, summary (html), contents: [], cover: {slug, ratio, alt}, cta: { label, href } }
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "primitives/picture.njk" import picture with context %}
{% from "primitives/badge.njk" import badge with context %}
{% from "primitives/button.njk" import button with context %}
{% from "components/prose.njk" import prose with context %}
{% macro render(s, ctx) %}
{% call shell("download-detail", s, ctx, { center: false, noReveal: true }) %}
<div class="grid gap-12 lg:grid-cols-3">
<div class="overflow-hidden rounded-xl">{{ picture(s.cover, { sizes: "(min-width: 64rem) 33vw, 100vw", class: "aspect-[3/4] w-full object-cover" }) }}</div>
<div class="lg:col-span-2">
<p class="flex items-center gap-2">{{ badge(s.fileType or "PDF", { tone: "brand" }) }}{% if s.pages %}<span class="text-sm text-ink-muted">{{ s.pages }}</span>{% endif %}</p>
<div class="mt-4">{{ prose(s.summary) }}</div>
{%- set ch = "h3" if s.title else "h2" -%}
{%- if s.contents %}<{{ ch }} class="mt-8 text-lg font-semibold">{{ s.contentsTitle or ("ui.whatIsInside" | t) }}</{{ ch }}><ul class="mt-3 list-inside list-disc space-y-1 text-base text-ink-muted">{% for c in s.contents %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
{%- if s.cta %}<div class="mt-8">{{ button(s.cta.label, { href: s.cta.href, icon: "download" }) }}</div>{% endif %}
</div>
</div>
{% endcall %}
{% endmacro %}
