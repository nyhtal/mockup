{#
  name: feature-rows
  purpose: 2–4 alternating text + picture rows (R-SEC-03).
  anatomy: shell > div.space-y > div.grid(text + picture), picture side alternates
  variants: none
  states: none
  spacing: rows space-y-16; grid gap-12
  motion: each row slides from its inline edge; from the standard level the picture inside its frame sits deeper than the words (parallax-md over its own passage, overscanned 10 %, R-MOT-15)
  keyboard: optional link per row
  a11y: each row has an h3; pictures have alt
  i18n: the picture alternates by order, not by physical side
  content limits: title ≤ 60 chars; text ≤ 60 words; 2–4 rows
  data: s = { eyebrow, title, lede, items: [{ eyebrow, title, text, image, link: {label, href} }] }
#}
{% from "sections/_shell.njk" import shell, revealClasses, depth with context %}
{% from "primitives/picture.njk" import picture with context %}
{% from "primitives/button.njk" import button with context %}
{% macro render(s, ctx) %}
{% call shell("feature-rows", s, ctx, { itemsReveal: ctx.reveal, clipX: true }) %}
<div class="space-y-16 md:space-y-24">
{%- for item in s.items %}
<div class="grid items-center gap-12 lg:grid-cols-2{{ revealClasses(ctx.reveal, 'end' if loop.index is even else 'start', true) }}">
<div class="{{ 'lg:order-2' if loop.index is even }}">
{%- if item.eyebrow %}<p class="text-sm font-medium uppercase tracking-wide text-ink-brand">{{ item.eyebrow }}</p>{% endif %}
<h3 class="{{ 'mt-2' if item.eyebrow }} text-3xl md:text-4xl font-semibold tracking-tight text-balance">{{ item.title }}</h3>
<p class="mt-4 text-base leading-relaxed text-ink-muted">{{ item.text }}</p>
{%- if item.link %}<div class="mt-6">{{ button(item.link.label, { href: item.link.href, variant: "link", iconEnd: "arrow-right" }) }}</div>{% endif %}
</div>
<div class="overflow-clip rounded-2xl ring-1 ring-line {{ 'lg:order-1' if loop.index is even }}">{{ picture(item.image, { sizes: "(min-width: 64rem) 50vw, 100vw", class: "aspect-[4/3] w-full object-cover" + (" md:motion-safe:sda:scale-110" + depth('parallax-md') if ctx.flair and ctx.flair.parallaxMedia) }) }}</div>
</div>
{%- endfor %}
</div>
{% endcall %}
{% endmacro %}
