{#
  name: _shell (helper, not a section)
  purpose: The section skeleton every section uses (R-SEC-01, R-SEC-06, R-SEC-10, R-TOK-15, R-LAY-02): padding by density, surface, container, eyebrow + h2 + lede, body via caller, optional CTA, reveal classes below the fold.
  usage: {% call shell("feature-grid", s, ctx) %} …body… {% endcall %}; opts: itemsReveal (items stagger; the section keeps only the fallback and the heading group rises on its own), clipX (overflow-x-clip for sliding rows), noReveal, center (true centres the heading group; the default is start-aligned, DESIGN §4), kind ("scale" for a framed object; the default rise)
  ctx: { locale, pageUrl, density, surface, reveal, index }
#}
{% from "primitives/button.njk" import button with context %}
{#- Scroll-driven reveal where supported: rise (default), slide from an inline edge (kind = "start" | "end", mirrored under rtl:) or settle from 96 % (kind = "scale"); the script fallback only slides (never opacity 0) so content stays visible (R-MOT-04, R-MOT-05).
    sdaOnly leaves the script fallback to the parent section, for items that stagger inside it. The fallback is scoped to nosda (no scroll-driven animation) so the two paths never compound. -#}
{% macro revealClasses(on, kind="", sdaOnly=false) %}{% if on %} motion-safe:sda:animate-reveal{{ "-" + kind if kind }}{% if kind == "start" or kind == "end" %} rtl:motion-safe:sda:animate-reveal-{{ "start" if kind == "end" else "end" }}{% endif %} motion-safe:sda:[animation-timeline:view()] motion-safe:sda:[animation-range:entry_0%_cover_30%]{% if not sdaOnly %} motion-safe:nosda:js:not-data-revealed:translate-y-4 motion-safe:nosda:js:data-revealed:translate-y-0 motion-safe:nosda:js:transition-transform motion-safe:nosda:js:duration-(--reveal-duration) motion-safe:nosda:js:ease-smooth{% endif %}{% endif %}{% endmacro %}
{#- Staggered items: each item reveals on its own view() timeline with a range shifted 5 % per item (time delays do not apply to scroll timelines); eight items at most (R-MOT-03). kind as above. -#}
{% macro stagger(i, kind="") %}{% if i < 8 %} motion-safe:sda:animate-reveal{{ "-" + kind if kind }}{% if kind == "start" or kind == "end" %} rtl:motion-safe:sda:animate-reveal-{{ "start" if kind == "end" else "end" }}{% endif %} motion-safe:sda:[animation-timeline:view()] motion-safe:sda:[animation-range:entry_{{ i * 5 }}%_cover_{{ 30 + i * 5 }}%] motion-safe:sda:[animation-fill-mode:both]{% endif %}{% endmacro %}
{#- The eyebrow marker (DESIGN §4): a 12 px accent rule before the label that draws from the start edge as its section reveals (transform only). -#}
{% macro eyebrowRule(inverse=false, draw=false) %}before:h-0.5 before:w-3 before:rounded-full {{ 'before:bg-ink-inverse/70' if inverse else 'before:bg-accent-600' }}{% if draw %} before:origin-left rtl:before:origin-right motion-safe:sda:before:animate-draw motion-safe:sda:before:[animation-timeline:view()] motion-safe:sda:before:[animation-range:entry_0%_cover_40%]{% endif %}{% endmacro %}
{% macro shell(name, s, ctx, opts={}) %}
{%- set pad = "py-12 md:py-16" if ctx.density == "compact" else "py-16 md:py-24" -%}
{%- set surface = s.surface or ctx.surface or "bg-surface" -%}
{%- set inverse = surface == "bg-brand-700" -%}
{%- set reveal = ctx.reveal and not opts.noReveal -%}
{%- set center = opts.center === true -%}
<section class="{{ pad }} {{ surface }}{% if inverse %} text-ink-inverse{% endif %}{% if opts.clipX %} overflow-x-clip{% endif %}{% if opts.itemsReveal and reveal %} motion-safe:nosda:js:not-data-revealed:translate-y-4 motion-safe:nosda:js:data-revealed:translate-y-0 motion-safe:nosda:js:transition-transform motion-safe:nosda:js:duration-(--reveal-duration) motion-safe:nosda:js:ease-smooth{% else %}{{ revealClasses(reveal, opts.kind) }}{% endif %}"{% if reveal %} data-reveal{% endif %} data-component="{{ name }}"{% if s.variant %} data-variant="{{ s.variant }}"{% endif %}{% if s.anchor %} id="{{ s.anchor }}"{% endif %}{% if not s.title and s.label %} aria-label="{{ s.label }}"{% endif %}>
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
{%- if s.title or s.eyebrow or s.lede %}
<div class="{{ 'mx-auto max-w-3xl text-center' if center else 'max-w-3xl' }}{{ revealClasses(reveal and opts.itemsReveal, '', true) }}">
{%- if s.eyebrow %}<p class="flex items-center gap-2 {{ 'justify-center' if center }} text-sm font-medium uppercase tracking-wide {{ 'text-ink-inverse/80' if inverse else 'text-ink-brand' }} {{ eyebrowRule(inverse, reveal) }}">{{ s.eyebrow }}</p>{% endif %}
{%- if s.title %}<h2 class="{{ 'mt-2' if s.eyebrow }} text-3xl md:text-4xl font-semibold tracking-tight text-balance">{{ s.title }}</h2>{% endif %}
{%- if s.lede %}<p class="mt-4 text-lg md:text-xl {{ 'text-ink-inverse/80' if inverse else 'text-ink-muted' }}">{{ s.lede }}</p>{% endif %}
</div>
{%- endif %}
<div class="{{ 'mt-12 md:mt-16' if (s.title or s.eyebrow or s.lede) }}">
{{ caller() }}
</div>
{%- if s.cta %}
<div class="mt-12 {{ 'text-center' if center }}">{{ button(s.cta.label, { href: s.cta.href, variant: s.cta.variant or "secondary", iconEnd: "arrow-right" }) }}</div>
{%- endif %}
</div>
</section>
{% endmacro %}
