{#
  name: _shell (helper, not a section)
  purpose: The section skeleton every section uses (R-SEC-01, R-SEC-06, R-SEC-10, R-TOK-15, R-LAY-02): padding by density, surface, container, eyebrow + h2 + lede, body via caller, optional CTA, reveal presets below the fold (R-MOT-05).
  usage: {% call shell("feature-grid", s, ctx) %} …body… {% endcall %}; opts: itemsReveal (items carry their own presets; the section keeps only the fallback, clips horizontal overflow because items may slide, and the heading group rises first), clipX (overflow-x-clip for sliding rows), noReveal, center (true centres the heading group; the default is start-aligned, DESIGN §4), kind ("scale" for a framed object; the default rise)
  ctx: { locale, pageUrl, density, surface, reveal, index, flair }; flair = the booleans of the brief's motion level (R-TOK-12): vocabulary, pop, rule, …
  macros: revealClasses (section preset), headingClasses (heading preset), item (item preset: treatment by column, R-MOT-16), stagger (sequence preset: shift by index), pop (icon pop), eyebrowRule (the marker that draws)
#}
{% from "primitives/button.njk" import button with context %}
{#- Script fallback for browsers without scroll-driven animation (nosda): one slide per section, never opacity, so content stays visible (R-MOT-04). -#}
{% macro fallback() %} motion-safe:nosda:js:not-data-revealed:translate-y-(--reveal-distance) motion-safe:nosda:js:data-revealed:translate-y-0 motion-safe:nosda:js:transition-transform motion-safe:nosda:js:duration-(--reveal-duration) motion-safe:nosda:js:ease-smooth{% endmacro %}
{#- Section preset: rise (or slide from an inline edge, kind = "start" | "end", mirrored under rtl:, or settle from 96 %, kind = "scale") over entry 0 % → cover 25 %. sdaOnly leaves the fallback to a parent. -#}
{% macro revealClasses(on, kind="", sdaOnly=false) %}{% if on %} motion-safe:sda:animate-reveal{{ "-" + kind if kind }}{% if kind == "start" or kind == "end" %} rtl:motion-safe:sda:animate-reveal-{{ "start" if kind == "end" else "end" }}{% endif %} motion-safe:sda:[animation-timeline:view()] motion-safe:sda:[animation-range:entry_0%_cover_25%] motion-safe:sda:[animation-fill-mode:both]{% if not sdaOnly %}{{ fallback() }}{% endif %}{% endif %}{% endmacro %}
{#- Heading preset: the heading group of a section whose items stagger rises first (cover 0 % → 20 %); the section's fallback moves it in nosda browsers. -#}
{% macro headingClasses(on) %}{% if on %} motion-safe:sda:animate-reveal motion-safe:sda:[animation-timeline:view()] motion-safe:sda:[animation-range:cover_0%_cover_20%] motion-safe:sda:[animation-fill-mode:both]{% endif %}{% endmacro %}
{#- Item preset (R-MOT-16): the treatment of the item's column (3 columns: slide-in / rise / framed settle; 4: + slide-from-end; 2: slide-in / slide-from-end), range cover 5 % → 25 % shifted 3 % per column and reset per row; kind forces one treatment ("rise", "start", "end", "settle", "scale"). Below the standard level everything rises. -#}
{% macro item(i, cols, ctx, kind="") %}{% if ctx.reveal %}{% set c = i % cols %}{% set t = kind %}{% if not t and ctx.flair and ctx.flair.vocabulary %}{% set v = ["start", "rise", "settle", "end"] if cols == 4 else (["start", "end"] if cols == 2 else ["start", "rise", "settle"]) %}{% set t = v[c] %}{% endif %}{% if t == "rise" %}{% set t = "" %}{% endif %} motion-safe:sda:animate-reveal{{ "-" + t if t }}{% if t == "start" or t == "end" %} rtl:motion-safe:sda:animate-reveal-{{ "start" if t == "end" else "end" }}{% endif %} motion-safe:sda:[animation-timeline:view()] motion-safe:sda:[animation-range:cover_{{ 5 + c * 3 }}%_cover_{{ 25 + c * 3 }}%] motion-safe:sda:[animation-fill-mode:both]{% endif %}{% endmacro %}
{#- Sequence preset: items of a list (timeline, logo cloud, steps) shift 3 % per item, eight at most (R-MOT-03); kind as above. -#}
{% macro stagger(i, kind="") %}{% if i < 8 %}{% if kind == "rise" %}{% set kind = "" %}{% endif %} motion-safe:sda:animate-reveal{{ "-" + kind if kind }}{% if kind == "start" or kind == "end" %} rtl:motion-safe:sda:animate-reveal-{{ "start" if kind == "end" else "end" }}{% endif %} motion-safe:sda:[animation-timeline:view()] motion-safe:sda:[animation-range:cover_{{ 5 + i * 3 }}%_cover_{{ 25 + i * 3 }}%] motion-safe:sda:[animation-fill-mode:both]{% endif %}{% endmacro %}
{#- Icon pop (expressive): the icon tile, avatar or badge inside an item scales .82 → 1.04 → 1 on its own view timeline. -#}
{% macro pop(ctx) %}{% if ctx.reveal and ctx.flair and ctx.flair.pop %} motion-safe:sda:animate-pop motion-safe:sda:[animation-timeline:view()] motion-safe:sda:[animation-range:cover_5%_cover_25%] motion-safe:sda:[animation-fill-mode:both]{% endif %}{% endmacro %}
{#- The eyebrow marker (DESIGN §4): a 24 px accent rule before the label that draws from the start edge as its section reveals (transform only). -#}
{% macro eyebrowRule(inverse=false, draw=false) %}before:h-0.5 before:w-6 before:rounded-full {{ 'before:bg-ink-inverse/70' if inverse else 'before:bg-accent-600' }}{% if draw %} before:origin-left rtl:before:origin-right motion-safe:sda:before:animate-draw motion-safe:sda:before:[animation-timeline:view()] motion-safe:sda:before:[animation-range:cover_5%_cover_20%] motion-safe:sda:before:[animation-fill-mode:both]{% endif %}{% endmacro %}
{% macro shell(name, s, ctx, opts={}) %}
{%- set pad = "py-12 md:py-16" if ctx.density == "compact" else "py-16 md:py-24" -%}
{%- set surface = s.surface or ctx.surface or "bg-surface" -%}
{%- set inverse = surface == "bg-brand-700" -%}
{%- set reveal = ctx.reveal and not opts.noReveal -%}
{%- set center = opts.center === true -%}
<section class="{{ pad }} {{ surface }}{% if inverse %} text-ink-inverse{% endif %}{% if opts.clipX or (opts.itemsReveal and reveal) %} overflow-x-clip{% endif %}{% if opts.itemsReveal and reveal %}{{ fallback() }}{% else %}{{ revealClasses(reveal, opts.kind) }}{% endif %}"{% if reveal %} data-reveal{% endif %} data-component="{{ name }}"{% if s.variant %} data-variant="{{ s.variant }}"{% endif %}{% if s.anchor %} id="{{ s.anchor }}"{% endif %}{% if not s.title and s.label %} aria-label="{{ s.label }}"{% endif %}>
<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
{%- if s.title or s.eyebrow or s.lede %}
<div class="{{ 'mx-auto max-w-3xl text-center' if center else 'max-w-3xl' }}{{ headingClasses(reveal and opts.itemsReveal) }}">
{%- if s.eyebrow %}<p class="flex items-center gap-2 {{ 'justify-center' if center }} text-sm font-medium uppercase tracking-wide {{ 'text-ink-inverse/80' if inverse else 'text-ink-brand' }} {{ eyebrowRule(inverse, reveal and ctx.flair and ctx.flair.rule) }}">{{ s.eyebrow }}</p>{% endif %}
{%- if s.title %}<h2 class="{{ 'mt-2' if s.eyebrow }} text-3xl md:text-4xl font-semibold tracking-tight text-balance">{{ s.title }}</h2>{% endif %}
{%- if s.lede %}<p class="mt-4 text-lg md:text-xl {{ 'text-ink-inverse/80' if inverse else 'text-ink-muted' }}">{{ s.lede }}</p>{% endif %}
</div>
{%- endif %}
<div class="{{ 'mt-12 md:mt-16' if (s.title or s.eyebrow or s.lede) }}">
{{ caller() }}
</div>
{%- if s.cta %}
<div class="mt-12 {{ 'text-center' if center }}">{{ button(s.cta.label, { href: s.cta.href, variant: s.cta.variant or "secondary", iconEnd: "arrow-right" }) }}</div>
{%- endif %}
</div>
</section>
{% endmacro %}
