{#
  name: logo-cloud
  purpose: 5–8 customer or partner wordmarks (R-SEC-03, R-ASSET-08).
  anatomy: section[aria-label] > container > p(label) + ul > li > wordmark
  variants: none
  states: none
  spacing: py-12; gap-x-12 gap-y-8
  motion: wordmarks slide in from the inline start one after another (DESIGN §3); they take the brand colour on hover (150 ms)
  keyboard: none (wordmarks are not links in the mockup)
  a11y: untitled section labelled by s.label; each wordmark has a title
  i18n: label from content
  content limits: 5–8 names
  data: s = { label, items: ["Alder Foods", …] }
#}
{% from "sections/_shell.njk" import shell, stagger with context %}
{% from "primitives/wordmark.njk" import wordmark with context %}
{% macro render(s, ctx) %}
{% call shell("logo-cloud", s, ctx, { center: true, itemsReveal: ctx.reveal, clipX: true }) %}
{%- if s.label %}<p class="text-center text-sm font-medium text-ink-muted">{{ s.label }}</p>{% endif %}
<ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-8{{ ' reveal-items' if ctx.reveal }}">
{%- for name in s.items %}<li class="{{ stagger(loop.index0, 'start') if ctx.reveal }}">{{ wordmark(name, { variant: "mono", class: "motion-safe:transition-colors motion-safe:duration-150 hover:fill-ink-brand" }) }}</li>{% endfor %}
</ul>
{% endcall %}
{% endmacro %}
