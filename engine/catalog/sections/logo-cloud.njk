{#
  name: logo-cloud
  purpose: 5–8 customer or partner wordmarks (R-SEC-03, R-ASSET-08).
  anatomy: section[aria-label] > container > p(label) + ul > li > wordmark
  variants: none
  states: none
  spacing: py-12; gap-x-12 gap-y-8
  motion: reveal as one group
  keyboard: none (wordmarks are not links in the mockup)
  a11y: untitled section labelled by s.label; each wordmark has a title
  i18n: label from content
  content limits: 5–8 names
  data: s = { label, items: ["Alder Foods", …] }
#}
{% from "sections/_shell.njk" import shell %}
{% from "primitives/wordmark.njk" import wordmark %}
{% macro render(s, ctx) %}
{% call shell("logo-cloud", s, ctx) %}
{%- if s.label %}<p class="text-center text-sm font-medium text-ink-muted">{{ s.label }}</p>{% endif %}
<ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
{%- for name in s.items %}<li>{{ wordmark(name, { variant: "mono" }) }}</li>{% endfor %}
</ul>
{% endcall %}
{% endmacro %}
