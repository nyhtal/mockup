{#
  name: timeline
  purpose: Company history or roadmap, 4–8 milestones (R-SEC-03).
  anatomy: shell(center false) > timeline component
  variants: none
  states: none
  spacing: max-w-3xl
  motion: reveals; once the line has drawn, a soft band of light runs down it once (gesture-trace, D66)
  keyboard: none
  a11y: ordered list with <time>
  i18n: none
  content limits: 4–8 items
  data: s = { eyebrow, title, lede, items: [{ date, dateIso, title, text }] }
#}
{% from "sections/_shell.njk" import shell with context %}
{% from "components/timeline.njk" import timeline with context %}
{% macro render(s, ctx) %}
{% call shell("timeline", s, ctx, { itemsReveal: ctx.reveal }) %}
<div class="max-w-3xl">{{ timeline(s.items, { reveal: ctx.reveal, gesture: ctx.reveal and ctx.flair and ctx.flair.gesture }) }}</div>
{% endcall %}
{% endmacro %}
